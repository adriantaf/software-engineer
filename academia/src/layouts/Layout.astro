---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { getCatalog, getLeccionesCatalog } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  bareMain?: boolean;
}

const {
  title = 'Atelier',
  description = 'Atelier: plan personal de ingeniería de software',
  bareMain = false,
} = Astro.props;
const fullTitle =
  title === 'Atelier' ? 'Atelier · Ingeniería de Software' : `${title} · Atelier`;
const catalogIds = getCatalog().materias.map((m) => m.id);
const leccionesCatalog = getLeccionesCatalog();
const continuarFallback = pathTo('materia/M01/leccion/L01');
const brandHref = pathTo('favicon.svg');
const pathname = Astro.url.pathname;
const base = pathTo().replace(/\/$/, '') || '';

function navCurrent(segment: string): boolean {
  const needle = `${base}/${segment}`.replace(/\/+/g, '/');
  const path = pathname.replace(/\/+$/, '') || '/';
  const target = needle.replace(/\/+$/, '');
  return path === target || path.startsWith(`${target}/`);
}
---

<!doctype html>
<html lang="es" data-theme="light" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Atelier" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="apple-touch-icon" href={pathTo('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={pathTo('manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="sticky top-0 z-[60] site-header" id="site-header">
      <div class="site-header__bar">
        <div class="site-header__lead">
          <button
            type="button"
            id="nav-drawer-toggle"
            class="nav-toggle lg:hidden"
            aria-label="Abrir menú"
            aria-controls="nav-drawer"
            aria-expanded="false"
          >
            <span class="nav-toggle__icons" aria-hidden="true">
              <svg
                id="nav-icon-open"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="nav-toggle__icon"
              >
                <path stroke-linecap="round" d="M5 7h14M5 12h14M5 17h14"></path>
              </svg>
              <svg
                id="nav-icon-close"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="nav-toggle__icon nav-toggle__icon--close hidden"
              >
                <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </span>
          </button>
          <a
            class="brand-mark"
            href={pathTo()}
            aria-label="Atelier — Ingeniería de Software — Inicio"
            transition:name="brand"
          >
            <img class="brand-mark__glyph" src={brandHref} width="28" height="28" alt="" />
            <span class="brand-mark__text">Atelier</span>
          </a>
        </div>

        <nav class="site-header__nav hidden lg:flex" aria-label="Principal">
          <ul class="site-header__links">
            <li>
              <a
                class="nav-link"
                href={pathTo('etapa/basica')}
                aria-current={navCurrent('etapa/basica') ? 'page' : undefined}>Básica</a
              >
            </li>
            <li>
              <a
                class="nav-link"
                href={pathTo('etapa/disciplinaria')}
                aria-current={navCurrent('etapa/disciplinaria') ? 'page' : undefined}
                >Disciplinaria</a
              >
            </li>
            <li>
              <a
                class="nav-link"
                href={pathTo('etapa/terminal')}
                aria-current={navCurrent('etapa/terminal') ? 'page' : undefined}>Terminal</a
              >
            </li>
            <li>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="nav-link nav-link--menu">Guías</div>
                <ul
                  tabindex="0"
                  class="menu menu-sm dropdown-content guides-menu z-50 mt-2 w-56 p-2"
                >
                  <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
                  <li><a href={pathTo('docs/sincronizar-progreso')}>Sincronizar progreso</a></li>
                  <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
                  <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
                  <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
                  <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
                  <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
                  <li><a href={pathTo('docs/seguridad')}>Hilo seguridad</a></li>
                  <li><a href={pathTo('docs/labs')}>Labs</a></li>
                  <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
                  <li><a href={pathTo('egreso')}>Egreso</a></li>
                  <li><a href={pathTo('nivel')}>Nivel</a></li>
                  <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
                  <li><a href={pathTo('revision')}>Repaso cronometrado</a></li>
                  <li class="menu-title"><span>Autoevaluación</span></li>
                  <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
                  <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
                  <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
                </ul>
              </div>
            </li>
            <li>
              <a
                class="nav-link"
                href={pathTo('progreso')}
                aria-current={navCurrent('progreso') ? 'page' : undefined}>Progreso</a
              >
            </li>
            <li>
              <a
                class="nav-link"
                href={pathTo('buscar')}
                aria-current={navCurrent('buscar') ? 'page' : undefined}>Buscar</a
              >
            </li>
          </ul>
        </nav>

        <div class="site-header__actions">
          <div id="auth-sync" class="site-header__auth hidden sm:flex">
            <button
              type="button"
              id="auth-google-btn"
              class="nav-link nav-link--ghost"
              hidden
              title="Iniciar sesión con Google para sincronizar el progreso"
            >
              Entrar
            </button>
            <a
              id="auth-account-btn"
              class="nav-link nav-link--account"
              href={pathTo('perfil')}
              hidden
              title="Ver perfil"
              aria-current={navCurrent('perfil') ? 'page' : undefined}
            >
              <img id="auth-avatar" alt="" class="size-5 rounded-full shrink-0" width="20" height="20" hidden />
              <span id="auth-sync-label" class="truncate">Perfil</span>
            </a>
          </div>
          <a
            class="btn btn-primary btn-sm site-header__cta"
            data-continuar
            href={continuarFallback}
            title="Siguiente lección incompleta"
          >
            Continuar
          </a>
        </div>
      </div>
    </header>

    <div
      id="auth-toast"
      class="fixed top-[4.5rem] inset-x-0 z-[70] px-3"
      hidden
      role="alert"
    >
      <div class="max-w-lg mx-auto surface-panel flex items-start gap-2 p-3 text-sm">
        <p id="auth-toast-msg" class="m-0 flex-1 min-w-0"></p>
        <button type="button" id="auth-toast-close" class="btn btn-ghost btn-xs" aria-label="Cerrar">
          ✕
        </button>
      </div>
    </div>

    <div id="nav-backdrop" class="nav-backdrop lg:hidden" hidden aria-hidden="true"></div>

    <nav
      id="nav-drawer"
      class="nav-drawer lg:hidden"
      aria-label="Menú móvil"
      aria-hidden="true"
      hidden
    >
      <div class="nav-drawer__inner">
        <div class="nav-drawer__head">
          <p class="nav-drawer__title">Menú</p>
          <span class="nav-drawer__hint">Esc para cerrar</span>
        </div>

        <div class="nav-drawer__scroll">
          <p class="nav-drawer__label">Cuenta</p>
          <ul class="nav-drawer__list">
            <li>
              <button type="button" id="auth-google-btn-drawer" class="nav-drawer__list-btn" hidden>
                Iniciar sesión con Google
              </button>
            </li>
            <li>
              <a id="auth-perfil-drawer" href={pathTo('perfil')} class="nav-drawer__list-btn" hidden
                >Mi perfil</a
              >
            </li>
            <li>
              <button type="button" id="auth-signout-drawer" class="nav-drawer__list-btn" hidden>
                Cerrar sesión
              </button>
            </li>
          </ul>

          <p class="nav-drawer__label">Estudiar</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo()}>Inicio</a></li>
            <li><a href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li><a href={pathTo('progreso')}>Progreso</a></li>
            <li><a href={pathTo('buscar')}>Buscar</a></li>
          </ul>

          <details class="nav-drawer__details">
            <summary class="nav-drawer__summary">Guías</summary>
            <ul class="nav-drawer__list nav-drawer__list--nested">
              <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
              <li><a href={pathTo('docs/sincronizar-progreso')}>Sincronizar progreso</a></li>
              <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
              <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
              <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
              <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
              <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
              <li><a href={pathTo('docs/seguridad')}>Hilo seguridad</a></li>
              <li><a href={pathTo('docs/labs')}>Labs</a></li>
              <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
              <li><a href={pathTo('egreso')}>Egreso</a></li>
              <li><a href={pathTo('nivel')}>Nivel</a></li>
              <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
              <li><a href={pathTo('revision')}>Repaso cronometrado</a></li>
            </ul>
          </details>

          <p class="nav-drawer__label">Autoevaluación</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <div
      id="pwa-update"
      class="fixed bottom-0 inset-x-0 z-50 border-t border-base-300 bg-base-100 px-3 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      hidden
      role="status"
    >
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm m-0">Hay una versión nueva del plan (contenido o UI).</p>
        <button id="pwa-update-btn" type="button" class="btn btn-primary btn-sm">
          Actualizar
        </button>
      </div>
    </div>

    <main
      id="contenido"
      class:list={[
        'page-enter',
        bareMain ? 'w-full min-w-0' : 'container mx-auto px-3 sm:px-4 py-6 sm:py-8 max-w-6xl w-full min-w-0',
      ]}
      data-pagefind-body
      tabindex="-1"
    >
      <slot />
    </main>

    <footer class="footer footer-center site-footer p-6">
      <aside class="max-w-prose px-2">
        <p class="font-display font-semibold text-base-content m-0">Atelier</p>
        <p class="text-sm m-0 mt-1">Ingeniería de software con proyectos reales y evidencia en git</p>
      </aside>
    </footer>

    <script type="application/json" id="catalog-ids" set:html={JSON.stringify(catalogIds)} />
    <script type="application/json" id="lecciones-catalog" set:html={JSON.stringify(leccionesCatalog)} />

    <script>
      import { initProgressFromSeed, resolveContinuePath } from '../lib/progress-client';
      import { pathTo } from '../lib/paths';
      import {
        onSyncStatus,
        signInWithGoogle,
        signOutGoogle,
        startProgressSync,
      } from '../lib/progress-sync';
      import { isFirebaseConfigured } from '../lib/firebase';

      initProgressFromSeed();
      startProgressSync();

      let unsubAuth: (() => void) | undefined;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;
      let drawerOpen = false;

      function unlockPageScroll() {
        const y = Number(document.body.dataset.navScrollY || 0);
        const hadLock = document.body.classList.contains('nav-drawer-open');
        document.documentElement.classList.remove('nav-drawer-open');
        document.documentElement.style.overflow = '';
        document.body.classList.remove('nav-drawer-open');
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        delete document.body.dataset.navScrollY;
        const siteHeader = document.getElementById('site-header');
        if (siteHeader) {
          siteHeader.style.position = '';
          siteHeader.style.top = '';
          siteHeader.style.left = '';
          siteHeader.style.right = '';
          siteHeader.style.width = '';
        }
        if (hadLock) window.scrollTo(0, y);
      }

      function lockPageScroll() {
        const y = window.scrollY;
        document.documentElement.classList.add('nav-drawer-open');
        document.documentElement.style.overflow = 'hidden';
        document.body.classList.add('nav-drawer-open');
        document.body.style.position = 'fixed';
        document.body.style.top = `-${y}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.dataset.navScrollY = String(y);
        const siteHeader = document.getElementById('site-header');
        if (siteHeader) {
          siteHeader.style.position = 'fixed';
          siteHeader.style.top = '0';
          siteHeader.style.left = '0';
          siteHeader.style.right = '0';
          siteHeader.style.width = '100%';
        }
      }

      function forceCloseNav() {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = undefined;
        }
        drawerOpen = false;
        unlockPageScroll();
        const toggle = document.getElementById('nav-drawer-toggle');
        const drawer = document.getElementById('nav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Abrir menú');
        drawer?.classList.remove('nav-drawer--open');
        backdrop?.classList.remove('nav-backdrop--open');
        drawer?.setAttribute('aria-hidden', 'true');
        backdrop?.setAttribute('aria-hidden', 'true');
        if (drawer) drawer.hidden = true;
        if (backdrop) backdrop.hidden = true;
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }

      function initAuthUi() {
        unsubAuth?.();
        unsubAuth = undefined;

        const btn = document.getElementById('auth-google-btn') as HTMLButtonElement | null;
        const accountBtn = document.getElementById('auth-account-btn') as HTMLAnchorElement | null;
        const label = document.getElementById('auth-sync-label');
        const avatar = document.getElementById('auth-avatar') as HTMLImageElement | null;
        const drawerIn = document.getElementById(
          'auth-google-btn-drawer',
        ) as HTMLButtonElement | null;
        const drawerOut = document.getElementById(
          'auth-signout-drawer',
        ) as HTMLButtonElement | null;
        const drawerPerfil = document.getElementById(
          'auth-perfil-drawer',
        ) as HTMLAnchorElement | null;
        const toast = document.getElementById('auth-toast');
        const toastMsg = document.getElementById('auth-toast-msg');
        const toastClose = document.getElementById('auth-toast-close');

        function showAuthToast(message: string) {
          if (!toast || !toastMsg || !message) return;
          toastMsg.textContent = message;
          toast.hidden = false;
        }

        toastClose?.addEventListener('click', () => {
          if (toast) toast.hidden = true;
        });

        if (!isFirebaseConfigured()) {
          btn?.setAttribute('hidden', '');
          accountBtn?.setAttribute('hidden', '');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.setAttribute('hidden', '');
          drawerPerfil?.setAttribute('hidden', '');
          return;
        }

        btn?.addEventListener('click', () => void signInWithGoogle());
        drawerIn?.addEventListener('click', () => void signInWithGoogle());
        drawerOut?.addEventListener('click', () => {
          if (confirm('¿Cerrar la sesión de Google? El progreso local se conserva.')) {
            void signOutGoogle();
          }
        });

        unsubAuth = onSyncStatus(({ status, user, message }) => {
          if (!isFirebaseConfigured()) return;

          if (status === 'error' && message) {
            showAuthToast(message);
          }

          if (!user) {
            btn?.removeAttribute('hidden');
            accountBtn?.setAttribute('hidden', '');
            drawerIn?.removeAttribute('hidden');
            drawerOut?.setAttribute('hidden', '');
            drawerPerfil?.setAttribute('hidden', '');
            if (btn) {
              btn.disabled = status === 'syncing';
              btn.textContent = status === 'syncing' ? '…' : 'Entrar';
            }
            if (drawerIn) {
              drawerIn.disabled = status === 'syncing';
              drawerIn.textContent =
                status === 'syncing' ? 'Conectando…' : 'Iniciar sesión con Google';
            }
            return;
          }

          btn?.setAttribute('hidden', '');
          accountBtn?.removeAttribute('hidden');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.removeAttribute('hidden');
          drawerPerfil?.removeAttribute('hidden');

          const name = user.displayName?.split(' ')[0] || 'Perfil';
          if (label) {
            label.textContent =
              status === 'syncing' ? 'Sincronizando…' : status === 'error' ? 'Error de sync' : name;
          }
          if (avatar) {
            if (user.photoURL) {
              avatar.src = user.photoURL;
              avatar.alt = user.displayName || 'Foto de perfil';
              avatar.hidden = false;
            } else {
              avatar.hidden = true;
            }
          }
        });
      }

      function syncContinuar() {
        const raw = document.getElementById('catalog-ids')?.textContent;
        const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
        let ids: string[] = [];
        let leccionesByMateria: Record<string, string[]> = {};
        try {
          ids = raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          ids = ['M01'];
        }
        try {
          leccionesByMateria = lecRaw
            ? (JSON.parse(lecRaw) as Record<string, string[]>)
            : {};
        } catch {
          leccionesByMateria = {};
        }
        const rel = resolveContinuePath(ids, leccionesByMateria);
        const href = pathTo(rel);
        const materiaId = rel.split('/')[1] ?? 'M01';
        const narrow = window.matchMedia('(max-width: 1023px)').matches;
        document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((a) => {
          a.href = href;
          a.textContent = narrow || materiaId === 'M01' ? 'Continuar' : `Continuar ${materiaId}`;
        });
      }

      function initNavDrawer() {
        const toggle = document.getElementById('nav-drawer-toggle');
        const drawer = document.getElementById('nav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        if (!toggle || !drawer || !backdrop) return;
        if (toggle.dataset.drawerBound === '1') return;
        toggle.dataset.drawerBound = '1';
        drawerOpen = toggle.getAttribute('aria-expanded') === 'true';

        function setOpen(next: boolean) {
          if (next === drawerOpen) return;
          drawerOpen = next;
          toggle!.setAttribute('aria-expanded', String(drawerOpen));
          toggle!.setAttribute('aria-label', drawerOpen ? 'Cerrar menú' : 'Abrir menú');
          drawer!.setAttribute('aria-hidden', String(!drawerOpen));
          backdrop!.setAttribute('aria-hidden', String(!drawerOpen));
          iconOpen?.classList.toggle('hidden', drawerOpen);
          iconClose?.classList.toggle('hidden', !drawerOpen);
          if (closeTimer) clearTimeout(closeTimer);

          if (drawerOpen) {
            lockPageScroll();
            drawer!.hidden = false;
            backdrop!.hidden = false;
            requestAnimationFrame(() => {
              drawer!.classList.add('nav-drawer--open');
              backdrop!.classList.add('nav-backdrop--open');
            });
            toggle!.focus();
          } else {
            drawer!.classList.remove('nav-drawer--open');
            backdrop!.classList.remove('nav-backdrop--open');
            unlockPageScroll();
            closeTimer = setTimeout(() => {
              if (!drawerOpen) {
                drawer!.hidden = true;
                backdrop!.hidden = true;
              }
            }, 200);
            toggle!.focus();
          }
        }

        toggle.addEventListener('click', () => setOpen(!drawerOpen));
        backdrop.addEventListener('click', () => setOpen(false));
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
      }

      function onShellPageLoad() {
        initNavDrawer();
        initAuthUi();
        syncContinuar();
      }

      document.addEventListener('astro:page-load', onShellPageLoad);
      document.addEventListener('astro:before-preparation', () => {
        forceCloseNav();
      });
      document.addEventListener('astro:after-swap', () => {
        forceCloseNav();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !drawerOpen) return;
        forceCloseNav();
        document.getElementById('nav-drawer-toggle')?.focus();
      });

      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) forceCloseNav();
      });

      window.addEventListener('academia-progress', syncContinuar);
      window.addEventListener('resize', syncContinuar);

      onShellPageLoad();
    </script>
  </body>
</html>
