---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCatalog, getLeccionesCatalog } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Plan', description = 'Plan de estudios de ingeniería de software' } = Astro.props;
const fullTitle = title === 'Plan' ? 'Plan de Ingeniería de Software' : `${title} · Plan`;
const catalog = getCatalog();
const catalogIds = catalog.materias.map((m) => m.id);
const leccionesCatalog = getLeccionesCatalog();
const continuarFallback = pathTo('materia/M01/leccion/L01');
const etapaById = Object.fromEntries(catalog.etapas.map((e) => [e.id, e.titulo]));
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F766E" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Plan" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="apple-touch-icon" href={pathTo('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={pathTo('manifest.webmanifest')} />
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-plan-surface text-plan-ink">
    <SiteHeader etapas={catalog.etapas} continuarHref={continuarFallback} />

    <div
      id="pwa-update"
      class="fixed bottom-0 inset-x-0 z-50 border-t border-plan-border bg-white px-3 py-3 shadow-lg pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      hidden
      role="status"
    >
      <div class="plan-shell flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm m-0">Hay una versión nueva del plan disponible.</p>
        <button id="pwa-update-btn" type="button" class="btn btn-primary btn-sm">Actualizar</button>
      </div>
    </div>

    <div
      id="auth-toast"
      class="fixed bottom-0 inset-x-0 z-[70] border-t border-plan-border bg-white px-3 py-3 shadow-lg pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      hidden
      role="alert"
    >
      <div class="plan-shell flex flex-wrap items-start justify-between gap-2">
        <p id="auth-toast-msg" class="text-sm m-0 text-plan-ink max-w-prose"></p>
        <button id="auth-toast-close" type="button" class="btn btn-ghost btn-sm shrink-0">Cerrar</button>
      </div>
    </div>

    <main class="flex-1 w-full min-w-0" data-pagefind-body>
      <slot />
    </main>

    <SiteFooter />

    <script type="application/json" id="catalog-ids" set:html={JSON.stringify(catalogIds)} />
    <script type="application/json" id="lecciones-catalog" set:html={JSON.stringify(leccionesCatalog)} />
    <script type="application/json" id="etapa-titles" set:html={JSON.stringify(etapaById)} />

    <script>
      import { initProgressFromSeed, resolveContinuePath } from '../lib/progress-client';
      import { pathTo } from '../lib/paths';
      import {
        onSyncStatus,
        signInWithGoogle,
        signOutGoogle,
        startProgressSync,
      } from '../lib/progress-sync';
      import { isFirebaseConfigured } from '../lib/firebase';

      initProgressFromSeed();
      startProgressSync();

      function initAuthUi() {
        const btn = document.getElementById('auth-google-btn') as HTMLButtonElement | null;
        const accountBtn = document.getElementById('auth-account-btn') as HTMLAnchorElement | null;
        const label = document.getElementById('auth-sync-label');
        const avatar = document.getElementById('auth-avatar') as HTMLImageElement | null;
        const drawerIn = document.getElementById('auth-google-btn-drawer') as HTMLButtonElement | null;
        const drawerOut = document.getElementById('auth-signout-drawer') as HTMLButtonElement | null;
        const drawerPerfil = document.getElementById('auth-perfil-drawer') as HTMLAnchorElement | null;
        const toast = document.getElementById('auth-toast');
        const toastMsg = document.getElementById('auth-toast-msg');
        const toastClose = document.getElementById('auth-toast-close');

        function showAuthToast(message: string) {
          if (!toast || !toastMsg || !message) return;
          toastMsg.textContent = message;
          toast.hidden = false;
        }

        toastClose?.addEventListener('click', () => {
          if (toast) toast.hidden = true;
        });

        if (!isFirebaseConfigured()) {
          btn?.setAttribute('hidden', '');
          accountBtn?.setAttribute('hidden', '');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.setAttribute('hidden', '');
          drawerPerfil?.setAttribute('hidden', '');
          return;
        }

        btn?.addEventListener('click', () => void signInWithGoogle());
        drawerIn?.addEventListener('click', () => void signInWithGoogle());
        drawerOut?.addEventListener('click', () => {
          if (confirm('¿Cerrar la sesión de Google? El progreso local se conserva.')) {
            void signOutGoogle();
          }
        });

        onSyncStatus(({ status, user, message }) => {
          if (!isFirebaseConfigured()) return;

          if (status === 'error' && message) {
            showAuthToast(message);
          }

          if (!user) {
            btn?.removeAttribute('hidden');
            accountBtn?.setAttribute('hidden', '');
            drawerIn?.removeAttribute('hidden');
            drawerOut?.setAttribute('hidden', '');
            drawerPerfil?.setAttribute('hidden', '');
            if (btn) {
              btn.disabled = status === 'syncing';
              btn.textContent = status === 'syncing' ? '…' : 'Entrar';
            }
            if (drawerIn) {
              drawerIn.disabled = status === 'syncing';
              drawerIn.textContent =
                status === 'syncing' ? 'Conectando…' : 'Iniciar sesión con Google';
            }
            return;
          }

          btn?.setAttribute('hidden', '');
          accountBtn?.removeAttribute('hidden');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.removeAttribute('hidden');
          drawerPerfil?.removeAttribute('hidden');

          const name = user.displayName?.split(' ')[0] || 'Perfil';
          if (label) {
            label.textContent =
              status === 'syncing' ? 'Sincronizando…' : status === 'error' ? 'Error de sync' : name;
          }
          if (avatar) {
            if (user.photoURL) {
              avatar.src = user.photoURL;
              avatar.alt = user.displayName || 'Foto de perfil';
              avatar.hidden = false;
            } else {
              avatar.hidden = true;
            }
          }
        });
      }

      initAuthUi();

      function syncContinuar() {
        const raw = document.getElementById('catalog-ids')?.textContent;
        const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
        let ids: string[] = [];
        let leccionesByMateria: Record<string, string[]> = {};
        try {
          ids = raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          ids = ['M01'];
        }
        try {
          leccionesByMateria = lecRaw
            ? (JSON.parse(lecRaw) as Record<string, string[]>)
            : {};
        } catch {
          leccionesByMateria = {};
        }
        const rel = resolveContinuePath(ids, leccionesByMateria);
        const href = pathTo(rel);
        const materiaId = rel.split('/')[1] ?? 'M01';
        const narrow = window.matchMedia('(max-width: 1023px)').matches;
        document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((a) => {
          a.href = href;
          if (a.hasAttribute('data-continuar-keep-label')) return;
          a.textContent = narrow || materiaId === 'M01' ? 'Continuar' : `Continuar ${materiaId}`;
        });
      }

      syncContinuar();
      window.addEventListener('academia-progress', syncContinuar);
      window.addEventListener('resize', syncContinuar);

      function initNavDrawer() {
        const toggle = document.getElementById('nav-drawer-toggle');
        const closeBtn = document.getElementById('nav-drawer-close');
        const drawer = document.getElementById('nav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        if (!toggle || !drawer || !backdrop) return;

        let open = false;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        const siteHeader = document.getElementById('site-header');

        function lockPageScroll() {
          const y = window.scrollY;
          document.documentElement.classList.add('nav-drawer-open');
          document.documentElement.style.overflow = 'hidden';
          document.body.classList.add('nav-drawer-open');
          document.body.style.position = 'fixed';
          document.body.style.top = `-${y}px`;
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
          document.body.dataset.navScrollY = String(y);
          if (siteHeader) {
            siteHeader.style.position = 'fixed';
            siteHeader.style.top = '0';
            siteHeader.style.left = '0';
            siteHeader.style.right = '0';
            siteHeader.style.width = '100%';
          }
        }

        function unlockPageScroll() {
          const y = Number(document.body.dataset.navScrollY || 0);
          document.documentElement.classList.remove('nav-drawer-open');
          document.documentElement.style.overflow = '';
          document.body.classList.remove('nav-drawer-open');
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          delete document.body.dataset.navScrollY;
          if (siteHeader) {
            siteHeader.style.position = '';
            siteHeader.style.top = '';
            siteHeader.style.left = '';
            siteHeader.style.right = '';
            siteHeader.style.width = '';
          }
          window.scrollTo(0, y);
        }

        function setOpen(next: boolean) {
          if (next === open) return;
          open = next;
          toggle!.setAttribute('aria-expanded', String(open));
          toggle!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          drawer!.setAttribute('aria-hidden', String(!open));
          backdrop!.setAttribute('aria-hidden', String(!open));
          iconOpen?.classList.toggle('hidden', open);
          iconClose?.classList.toggle('hidden', !open);
          if (closeTimer) clearTimeout(closeTimer);

          if (open) {
            lockPageScroll();
            drawer!.hidden = false;
            backdrop!.hidden = false;
            requestAnimationFrame(() => {
              drawer!.classList.add('nav-drawer--open');
              backdrop!.classList.add('nav-backdrop--open');
            });
            closeBtn?.focus();
          } else {
            drawer!.classList.remove('nav-drawer--open');
            backdrop!.classList.remove('nav-backdrop--open');
            unlockPageScroll();
            closeTimer = setTimeout(() => {
              if (!open) {
                drawer!.hidden = true;
                backdrop!.hidden = true;
              }
            }, 200);
            toggle!.focus();
          }
        }

        toggle.addEventListener('click', () => setOpen(!open));
        closeBtn?.addEventListener('click', () => setOpen(false));
        backdrop.addEventListener('click', () => setOpen(false));
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && open) setOpen(false);
        });
        window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
          if (e.matches && open) setOpen(false);
        });
      }

      initNavDrawer();
    </script>
  </body>
</html>
