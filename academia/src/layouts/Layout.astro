---
import '../styles/global.css';
import { getCatalog, getLeccionesCatalog } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Plan', description = 'Plan personal de ingeniería de software' } = Astro.props;
const fullTitle = title === 'Plan' ? 'Plan de Ingeniería de Software' : `${title} · Plan`;
const catalogIds = getCatalog().materias.map((m) => m.id);
const leccionesCatalog = getLeccionesCatalog();
const continuarFallback = pathTo('materia/M01/leccion/L01');
---

<!doctype html>
<html lang="es" data-theme="corporate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Plan" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="apple-touch-icon" href={pathTo('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={pathTo('manifest.webmanifest')} />
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-screen bg-base-200">
    <header class="sticky top-0 z-[60] border-b border-base-300 bg-base-100" id="site-header">
      <div class="navbar min-h-14 px-3 sm:px-4 gap-2 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-1 min-w-0 shrink-0">
          <button
            type="button"
            id="nav-drawer-toggle"
            class="btn btn-ghost btn-square btn-sm lg:hidden"
            aria-label="Abrir menú"
            aria-controls="nav-drawer"
            aria-expanded="false"
          >
            <svg
              id="nav-icon-open"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              id="nav-icon-close"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-5 hidden"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <a class="btn btn-ghost px-2 text-base font-bold tracking-tight" href={pathTo()}>Plan</a>
        </div>

        <nav class="hidden lg:flex flex-1 items-center justify-center min-w-0" aria-label="Principal">
          <ul class="flex items-center gap-0.5 text-sm flex-nowrap">
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm font-normal">Guías ▾</div>
                <ul
                  tabindex="0"
                  class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-52 p-2 shadow border border-base-300"
                >
                  <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
                  <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
                  <li><a href={pathTo('docs/sincronizar-progreso')}>Sincronizar progreso</a></li>
                  <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
                  <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
                  <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
                  <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
                  <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
                  <li><a href={pathTo('egreso')}>Egreso</a></li>
                  <li><a href={pathTo('nivel')}>Nivel</a></li>
                  <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
                  <li class="menu-title"><span>Autoevaluación</span></li>
                  <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
                  <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
                  <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
                </ul>
              </div>
            </li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('progreso')}>Progreso</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('buscar')}>Buscar</a></li>
          </ul>
        </nav>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 ml-auto lg:ml-0">
          <div id="auth-sync" class="flex items-center gap-1 min-w-0">
            <button
              type="button"
              id="auth-google-btn"
              class="btn btn-ghost btn-sm px-2"
              hidden
              title="Sincronizar progreso con Google"
            >
              Entrar
            </button>
            <button
              type="button"
              id="auth-account-btn"
              class="btn btn-ghost btn-sm px-1.5 gap-1 max-w-[9rem]"
              hidden
              title="Cuenta sincronizada"
            >
              <img id="auth-avatar" alt="" class="size-5 rounded-full shrink-0" width="20" height="20" hidden />
              <span id="auth-sync-label" class="text-xs truncate">Sync</span>
            </button>
          </div>
          <a
            class="btn btn-ghost btn-sm hidden sm:inline-flex"
            href={pathTo('buscar')}
            title="Buscar en el plan"
            aria-label="Buscar"
          >
            Buscar
          </a>
          <a
            class="btn btn-primary btn-sm"
            data-continuar
            href={continuarFallback}
            title="Última materia o siguiente incompleta"
          >
            Continuar
          </a>
        </div>
      </div>
    </header>

    <div id="nav-backdrop" class="nav-backdrop lg:hidden" hidden aria-hidden="true"></div>

    <nav
      id="nav-drawer"
      class="nav-drawer lg:hidden"
      aria-label="Menú móvil"
      aria-hidden="true"
      hidden
    >
      <div class="nav-drawer__inner">
        <div class="nav-drawer__head">
          <p class="nav-drawer__title">Menú</p>
          <button type="button" id="nav-drawer-close" class="btn btn-ghost btn-square btn-sm" aria-label="Cerrar menú">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true">
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>

        <div class="nav-drawer__scroll">
          <p class="nav-drawer__label">Cuenta</p>
          <ul class="nav-drawer__list">
            <li>
              <button type="button" id="auth-google-btn-drawer" class="nav-drawer__list-btn" hidden>
                Entrar con Google (sync)
              </button>
            </li>
            <li>
              <button type="button" id="auth-signout-drawer" class="nav-drawer__list-btn" hidden>
                Cerrar sesión
              </button>
            </li>
          </ul>

          <p class="nav-drawer__label">Estudiar</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo()}>Inicio</a></li>
            <li><a href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li><a href={pathTo('progreso')}>Progreso</a></li>
            <li><a href={pathTo('buscar')}>Buscar</a></li>
          </ul>

          <details class="nav-drawer__details">
            <summary class="nav-drawer__summary">Guías</summary>
            <ul class="nav-drawer__list nav-drawer__list--nested">
              <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
              <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
              <li><a href={pathTo('docs/sincronizar-progreso')}>Sincronizar progreso</a></li>
              <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
              <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
              <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
              <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
              <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
              <li><a href={pathTo('egreso')}>Egreso</a></li>
              <li><a href={pathTo('nivel')}>Nivel</a></li>
              <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
            </ul>
          </details>

          <p class="nav-drawer__label">Autoevaluación</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <div
      id="pwa-update"
      class="fixed bottom-0 inset-x-0 z-50 border-t border-base-300 bg-base-100 px-3 py-3 shadow-lg pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      hidden
      role="status"
    >
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm m-0">Hay una versión nueva del plan (contenido o UI).</p>
        <button id="pwa-update-btn" type="button" class="btn btn-primary btn-sm">
          Actualizar
        </button>
      </div>
    </div>

    <main
      class="container mx-auto px-3 sm:px-4 py-6 sm:py-8 max-w-6xl w-full min-w-0"
      data-pagefind-body
    >
      <slot />
    </main>

    <footer class="footer footer-center bg-base-100 text-base-content p-6 border-t border-base-300">
      <aside class="max-w-prose px-2">
        <p class="font-medium">Plan de Ingeniería de Software</p>
        <p class="text-sm opacity-70">Mejorado con proyectos reales y evidencia en git</p>
      </aside>
    </footer>

    <script type="application/json" id="catalog-ids" set:html={JSON.stringify(catalogIds)} />
    <script type="application/json" id="lecciones-catalog" set:html={JSON.stringify(leccionesCatalog)} />

    <script>
      import { initProgressFromSeed, resolveContinuePath } from '../lib/progress-client';
      import { pathTo } from '../lib/paths';
      import {
        onSyncStatus,
        signInWithGoogle,
        signOutGoogle,
        startProgressSync,
      } from '../lib/progress-sync';
      import { isFirebaseConfigured } from '../lib/firebase';

      initProgressFromSeed();
      startProgressSync();

      function initAuthUi() {
        const btn = document.getElementById('auth-google-btn') as HTMLButtonElement | null;
        const accountBtn = document.getElementById('auth-account-btn') as HTMLButtonElement | null;
        const label = document.getElementById('auth-sync-label');
        const avatar = document.getElementById('auth-avatar') as HTMLImageElement | null;
        const drawerIn = document.getElementById('auth-google-btn-drawer') as HTMLButtonElement | null;
        const drawerOut = document.getElementById('auth-signout-drawer') as HTMLButtonElement | null;

        if (!isFirebaseConfigured()) {
          btn?.setAttribute('hidden', '');
          accountBtn?.setAttribute('hidden', '');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.setAttribute('hidden', '');
          return;
        }

        btn?.addEventListener('click', () => void signInWithGoogle());
        drawerIn?.addEventListener('click', () => void signInWithGoogle());
        accountBtn?.addEventListener('click', () => {
          if (confirm('¿Cerrar sesión de Google? El progreso local se conserva.')) {
            void signOutGoogle();
          }
        });
        drawerOut?.addEventListener('click', () => void signOutGoogle());

        onSyncStatus(({ status, user }) => {
          const configured = isFirebaseConfigured();
          if (!configured) return;

          if (!user) {
            btn?.removeAttribute('hidden');
            accountBtn?.setAttribute('hidden', '');
            drawerIn?.removeAttribute('hidden');
            drawerOut?.setAttribute('hidden', '');
            if (btn) {
              btn.disabled = status === 'syncing';
              btn.textContent = status === 'syncing' ? '…' : 'Entrar';
            }
            return;
          }

          btn?.setAttribute('hidden', '');
          accountBtn?.removeAttribute('hidden');
          drawerIn?.setAttribute('hidden', '');
          drawerOut?.removeAttribute('hidden');

          const name = user.displayName?.split(' ')[0] || 'Cuenta';
          if (label) {
            label.textContent =
              status === 'syncing' ? 'Sync…' : status === 'error' ? 'Error sync' : name;
          }
          if (avatar) {
            if (user.photoURL) {
              avatar.src = user.photoURL;
              avatar.hidden = false;
            } else {
              avatar.hidden = true;
            }
          }
        });
      }

      initAuthUi();

      function syncContinuar() {
        const raw = document.getElementById('catalog-ids')?.textContent;
        const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
        let ids: string[] = [];
        let leccionesByMateria: Record<string, string[]> = {};
        try {
          ids = raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          ids = ['M01'];
        }
        try {
          leccionesByMateria = lecRaw
            ? (JSON.parse(lecRaw) as Record<string, string[]>)
            : {};
        } catch {
          leccionesByMateria = {};
        }
        const rel = resolveContinuePath(ids, leccionesByMateria);
        const href = pathTo(rel);
        const materiaId = rel.split('/')[1] ?? 'M01';
        const narrow = window.matchMedia('(max-width: 1023px)').matches;
        document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((a) => {
          a.href = href;
          // En móvil el label corto evita que pelee con el brand.
          a.textContent = narrow || materiaId === 'M01' ? 'Continuar' : `Continuar ${materiaId}`;
        });
      }

      syncContinuar();
      window.addEventListener('academia-progress', syncContinuar);
      window.addEventListener('resize', syncContinuar);

      function initNavDrawer() {
        const toggle = document.getElementById('nav-drawer-toggle');
        const closeBtn = document.getElementById('nav-drawer-close');
        const drawer = document.getElementById('nav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        if (!toggle || !drawer || !backdrop) return;

        let open = false;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        const siteHeader = document.getElementById('site-header');

        function lockPageScroll() {
          const y = window.scrollY;
          document.documentElement.classList.add('nav-drawer-open');
          document.documentElement.style.overflow = 'hidden';
          document.body.classList.add('nav-drawer-open');
          document.body.style.position = 'fixed';
          document.body.style.top = `-${y}px`;
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
          document.body.dataset.navScrollY = String(y);
          // Sticky deja de “pegarse” con body fixed; anclar header al viewport.
          if (siteHeader) {
            siteHeader.style.position = 'fixed';
            siteHeader.style.top = '0';
            siteHeader.style.left = '0';
            siteHeader.style.right = '0';
            siteHeader.style.width = '100%';
          }
        }

        function unlockPageScroll() {
          const y = Number(document.body.dataset.navScrollY || 0);
          document.documentElement.classList.remove('nav-drawer-open');
          document.documentElement.style.overflow = '';
          document.body.classList.remove('nav-drawer-open');
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          delete document.body.dataset.navScrollY;
          if (siteHeader) {
            siteHeader.style.position = '';
            siteHeader.style.top = '';
            siteHeader.style.left = '';
            siteHeader.style.right = '';
            siteHeader.style.width = '';
          }
          window.scrollTo(0, y);
        }

        function setOpen(next: boolean) {
          if (next === open) return;
          open = next;
          toggle!.setAttribute('aria-expanded', String(open));
          toggle!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          drawer!.setAttribute('aria-hidden', String(!open));
          backdrop!.setAttribute('aria-hidden', String(!open));
          iconOpen?.classList.toggle('hidden', open);
          iconClose?.classList.toggle('hidden', !open);
          if (closeTimer) clearTimeout(closeTimer);

          if (open) {
            lockPageScroll();
            drawer!.hidden = false;
            backdrop!.hidden = false;
            requestAnimationFrame(() => {
              drawer!.classList.add('nav-drawer--open');
              backdrop!.classList.add('nav-backdrop--open');
            });
            closeBtn?.focus();
          } else {
            drawer!.classList.remove('nav-drawer--open');
            backdrop!.classList.remove('nav-backdrop--open');
            unlockPageScroll();
            closeTimer = setTimeout(() => {
              if (!open) {
                drawer!.hidden = true;
                backdrop!.hidden = true;
              }
            }, 200);
            toggle!.focus();
          }
        }

        toggle.addEventListener('click', () => setOpen(!open));
        closeBtn?.addEventListener('click', () => setOpen(false));
        backdrop.addEventListener('click', () => setOpen(false));
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && open) setOpen(false);
        });
        window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
          if (e.matches && open) setOpen(false);
        });
      }

      initNavDrawer();
    </script>
  </body>
</html>
