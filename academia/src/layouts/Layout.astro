---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { getCatalog, getLeccionesCatalog } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  bareMain?: boolean;
}

const {
  title = 'Plan',
  description = 'Plan personal de ingeniería de software',
  bareMain = false,
} = Astro.props;
const fullTitle = title === 'Plan' ? 'Plan de Ingeniería de Software' : `${title} · Plan`;
const catalogIds = getCatalog().materias.map((m) => m.id);
const leccionesCatalog = getLeccionesCatalog();
const continuarFallback = pathTo('materia/M01/leccion/L01');
const brandHref = pathTo('favicon.svg');
const pathname = Astro.url.pathname;
const base = pathTo().replace(/\/$/, '') || '';

function navCurrent(segment: string): boolean {
  const needle = `${base}/${segment}`.replace(/\/+/g, '/');
  const path = pathname.replace(/\/+$/, '') || '/';
  const target = needle.replace(/\/+$/, '');
  return path === target || path.startsWith(`${target}/`);
}
---

<!doctype html>
<html lang="es" data-theme="light" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Plan" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="apple-touch-icon" href={pathTo('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={pathTo('manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="sticky top-0 z-[60] site-header" id="site-header">
      <div class="navbar min-h-14 px-3 sm:px-4 gap-2 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-1 min-w-0 shrink-0">
          <button
            type="button"
            id="nav-drawer-toggle"
            class="btn btn-ghost btn-square btn-sm lg:hidden"
            aria-label="Abrir menú"
            aria-controls="nav-drawer"
            aria-expanded="false"
          >
            <svg
              id="nav-icon-open"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              id="nav-icon-close"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="size-5 hidden"
              aria-hidden="true"
            >
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <a
            class="brand-mark px-1 py-1"
            href={pathTo()}
            aria-label="Plan de Ingeniería de Software — Inicio"
            transition:name="brand"
          >
            <img class="brand-mark__glyph" src={brandHref} width="24" height="24" alt="" />
            <span class="brand-mark__text">Plan</span>
          </a>
        </div>

        <nav class="hidden lg:flex flex-1 items-center justify-center min-w-0" aria-label="Principal">
          <ul class="flex items-center gap-0.5 text-sm flex-nowrap">
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('etapa/basica')}
                aria-current={navCurrent('etapa/basica') ? 'page' : undefined}>Básica</a
              >
            </li>
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('etapa/disciplinaria')}
                aria-current={navCurrent('etapa/disciplinaria') ? 'page' : undefined}
                >Disciplinaria</a
              >
            </li>
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('etapa/terminal')}
                aria-current={navCurrent('etapa/terminal') ? 'page' : undefined}>Terminal</a
              >
            </li>
            <li>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm font-normal">Guías ▾</div>
                <ul
                  tabindex="0"
                  class="menu menu-sm dropdown-content guides-menu z-50 mt-2 w-52 p-2"
                >
                  <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
                  <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
                  <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
                  <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
                  <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
                  <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
                  <li><a href={pathTo('docs/seguridad')}>Hilo seguridad</a></li>
                  <li><a href={pathTo('docs/labs')}>Labs</a></li>
                  <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
                  <li><a href={pathTo('egreso')}>Egreso</a></li>
                  <li><a href={pathTo('nivel')}>Nivel</a></li>
                  <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
                  <li><a href={pathTo('revision')}>Revisión de emergencia</a></li>
                  <li class="menu-title"><span>Autoevaluación</span></li>
                  <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
                  <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
                  <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
                </ul>
              </div>
            </li>
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('revision')}
                aria-current={navCurrent('revision') ? 'page' : undefined}>Revisión</a
              >
            </li>
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('progreso')}
                aria-current={navCurrent('progreso') ? 'page' : undefined}>Progreso</a
              >
            </li>
            <li>
              <a
                class="btn btn-ghost btn-sm font-normal nav-link"
                href={pathTo('buscar')}
                aria-current={navCurrent('buscar') ? 'page' : undefined}>Buscar</a
              >
            </li>
          </ul>
        </nav>

        <div class="flex items-center gap-2 shrink-0 ml-auto lg:ml-0">
          <a
            class="btn btn-primary btn-sm"
            data-continuar
            href={continuarFallback}
            title="Siguiente lección incompleta"
          >
            Continuar
          </a>
        </div>
      </div>
    </header>

    <div id="nav-backdrop" class="nav-backdrop lg:hidden" hidden aria-hidden="true"></div>

    <nav
      id="nav-drawer"
      class="nav-drawer lg:hidden"
      aria-label="Menú móvil"
      aria-hidden="true"
      hidden
    >
      <div class="nav-drawer__inner">
        <div class="nav-drawer__head">
          <p class="nav-drawer__title">Menú</p>
          {/* Cierre: el toggle del header pasa a icono X; evitamos un segundo botón. */}
          <span class="text-xs opacity-50 pr-1">Esc para cerrar</span>
        </div>

        <div class="nav-drawer__scroll">
          <p class="nav-drawer__label">Estudiar</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo()}>Inicio</a></li>
            <li><a href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li><a href={pathTo('revision')}>Revisión de emergencia</a></li>
            <li><a href={pathTo('progreso')}>Progreso</a></li>
            <li><a href={pathTo('buscar')}>Buscar</a></li>
          </ul>

          <details class="nav-drawer__details">
            <summary class="nav-drawer__summary">Guías</summary>
            <ul class="nav-drawer__list nav-drawer__list--nested">
              <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
              <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
              <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
              <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
              <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
              <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
              <li><a href={pathTo('docs/seguridad')}>Hilo seguridad</a></li>
              <li><a href={pathTo('docs/labs')}>Labs</a></li>
              <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
              <li><a href={pathTo('egreso')}>Egreso</a></li>
              <li><a href={pathTo('nivel')}>Nivel</a></li>
              <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
            </ul>
          </details>

          <p class="nav-drawer__label">Autoevaluación</p>
          <ul class="nav-drawer__list">
            <li><a href={pathTo('etapa/basica/examen')}>Examen Básica</a></li>
            <li><a href={pathTo('etapa/disciplinaria/examen')}>Examen Disciplinaria</a></li>
            <li><a href={pathTo('etapa/terminal/examen')}>Examen Terminal</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <div
      id="pwa-update"
      class="fixed bottom-0 inset-x-0 z-50 border-t border-base-300 bg-base-100 px-3 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      hidden
      role="status"
    >
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm m-0">Hay una versión nueva del plan (contenido o UI).</p>
        <button id="pwa-update-btn" type="button" class="btn btn-primary btn-sm">
          Actualizar
        </button>
      </div>
    </div>

    <main
      id="contenido"
      class:list={[
        'page-enter',
        bareMain ? 'w-full min-w-0' : 'container mx-auto px-3 sm:px-4 py-6 sm:py-8 max-w-6xl w-full min-w-0',
      ]}
      data-pagefind-body
      tabindex="-1"
    >
      <slot />
    </main>

    <footer class="footer footer-center site-footer p-6">
      <aside class="max-w-prose px-2">
        <p class="font-display font-semibold text-base-content m-0">Plan de Ingeniería de Software</p>
        <p class="text-sm m-0 mt-1">Mejorado con proyectos reales y evidencia en git</p>
      </aside>
    </footer>

    <script type="application/json" id="catalog-ids" set:html={JSON.stringify(catalogIds)} />
    <script type="application/json" id="lecciones-catalog" set:html={JSON.stringify(leccionesCatalog)} />

    <script>
      import { initProgressFromSeed, resolveContinuePath } from '../lib/progress-client';
      import { pathTo } from '../lib/paths';

      initProgressFromSeed();

      function syncContinuar() {
        const raw = document.getElementById('catalog-ids')?.textContent;
        const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
        let ids: string[] = [];
        let leccionesByMateria: Record<string, string[]> = {};
        try {
          ids = raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          ids = ['M01'];
        }
        try {
          leccionesByMateria = lecRaw
            ? (JSON.parse(lecRaw) as Record<string, string[]>)
            : {};
        } catch {
          leccionesByMateria = {};
        }
        const rel = resolveContinuePath(ids, leccionesByMateria);
        const href = pathTo(rel);
        const materiaId = rel.split('/')[1] ?? 'M01';
        const narrow = window.matchMedia('(max-width: 1023px)').matches;
        document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((a) => {
          a.href = href;
          a.textContent = narrow || materiaId === 'M01' ? 'Continuar' : `Continuar ${materiaId}`;
        });
      }

      syncContinuar();
      window.addEventListener('academia-progress', syncContinuar);
      window.addEventListener('resize', syncContinuar);

      function initNavDrawer() {
        const toggle = document.getElementById('nav-drawer-toggle');
        const drawer = document.getElementById('nav-drawer');
        const backdrop = document.getElementById('nav-backdrop');
        const iconOpen = document.getElementById('nav-icon-open');
        const iconClose = document.getElementById('nav-icon-close');
        if (!toggle || !drawer || !backdrop) return;
        if (toggle.dataset.drawerBound === '1') return;
        toggle.dataset.drawerBound = '1';

        let open = false;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        const siteHeader = document.getElementById('site-header');

        function lockPageScroll() {
          const y = window.scrollY;
          document.documentElement.classList.add('nav-drawer-open');
          document.documentElement.style.overflow = 'hidden';
          document.body.classList.add('nav-drawer-open');
          document.body.style.position = 'fixed';
          document.body.style.top = `-${y}px`;
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
          document.body.dataset.navScrollY = String(y);
          if (siteHeader) {
            siteHeader.style.position = 'fixed';
            siteHeader.style.top = '0';
            siteHeader.style.left = '0';
            siteHeader.style.right = '0';
            siteHeader.style.width = '100%';
          }
        }

        function unlockPageScroll() {
          const y = Number(document.body.dataset.navScrollY || 0);
          document.documentElement.classList.remove('nav-drawer-open');
          document.documentElement.style.overflow = '';
          document.body.classList.remove('nav-drawer-open');
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          delete document.body.dataset.navScrollY;
          if (siteHeader) {
            siteHeader.style.position = '';
            siteHeader.style.top = '';
            siteHeader.style.left = '';
            siteHeader.style.right = '';
            siteHeader.style.width = '';
          }
          window.scrollTo(0, y);
        }

        function setOpen(next: boolean) {
          if (next === open) return;
          open = next;
          toggle!.setAttribute('aria-expanded', String(open));
          toggle!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          drawer!.setAttribute('aria-hidden', String(!open));
          backdrop!.setAttribute('aria-hidden', String(!open));
          iconOpen?.classList.toggle('hidden', open);
          iconClose?.classList.toggle('hidden', !open);
          if (closeTimer) clearTimeout(closeTimer);

          if (open) {
            lockPageScroll();
            drawer!.hidden = false;
            backdrop!.hidden = false;
            requestAnimationFrame(() => {
              drawer!.classList.add('nav-drawer--open');
              backdrop!.classList.add('nav-backdrop--open');
            });
            // El toggle del header es el único control de cierre (pasa a X).
            toggle!.focus();
          } else {
            drawer!.classList.remove('nav-drawer--open');
            backdrop!.classList.remove('nav-backdrop--open');
            unlockPageScroll();
            closeTimer = setTimeout(() => {
              if (!open) {
                drawer!.hidden = true;
                backdrop!.hidden = true;
              }
            }, 200);
            toggle!.focus();
          }
        }

        toggle.addEventListener('click', () => setOpen(!open));
        backdrop.addEventListener('click', () => setOpen(false));
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && open) setOpen(false);
        });
        window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
          if (e.matches && open) setOpen(false);
        });
      }

      initNavDrawer();
    </script>
  </body>
</html>
