---
import '../styles/global.css';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Academia', description = 'Plan de egreso competente en ingeniería de software' } = Astro.props;
const fullTitle = title === 'Academia' ? 'Academia de Egreso Competente' : `${title} · Academia`;
---

<!doctype html>
<html lang="es" data-theme="corporate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
  </head>
  <body class="min-h-screen bg-base-200">
    <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100">
      <div class="navbar min-h-14 px-3 sm:px-4 gap-2 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-1 min-w-0 shrink-0">
          <div class="dropdown lg:hidden">
            <div tabindex="0" role="button" class="btn btn-ghost btn-square btn-sm" aria-label="Menú">☰</div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-56 p-2 shadow border border-base-300"
            >
              <li><a href={pathTo()}>Inicio</a></li>
              <li><a href={pathTo('etapa/basica')}>Básica</a></li>
              <li><a href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
              <li><a href={pathTo('etapa/terminal')}>Terminal</a></li>
              <li><a href={pathTo('progreso')}>Progreso</a></li>
              <li class="menu-title"><span>Guías</span></li>
              <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
              <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
              <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
              <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
              <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
              <li><a href={pathTo('egreso')}>Egreso</a></li>
              <li><a href={pathTo('nivel')}>Nivel</a></li>
              <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
            </ul>
          </div>
          <a class="btn btn-ghost px-2 text-base font-bold tracking-tight" href={pathTo()}>Academia</a>
        </div>

        <nav class="hidden lg:flex flex-1 items-center justify-center min-w-0" aria-label="Principal">
          <ul class="flex items-center gap-0.5 text-sm flex-nowrap">
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm font-normal">Guías ▾</div>
                <ul
                  tabindex="0"
                  class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-52 p-2 shadow border border-base-300"
                >
                  <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
                  <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
                  <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
                  <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
                  <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
                  <li><a href={pathTo('egreso')}>Egreso</a></li>
                  <li><a href={pathTo('nivel')}>Nivel</a></li>
                  <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
                </ul>
              </div>
            </li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('progreso')}>Progreso</a></li>
          </ul>
        </nav>

        <div class="flex items-center gap-2 shrink-0 ml-auto lg:ml-0">
          <a class="btn btn-primary btn-sm" href={pathTo('materia/M01')}>Continuar</a>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-3 sm:px-4 py-6 sm:py-8 max-w-6xl w-full min-w-0">
      <slot />
    </main>

    <footer class="footer footer-center bg-base-100 text-base-content p-6 border-t border-base-300">
      <aside class="max-w-prose px-2">
        <p class="font-medium">Academia de Egreso Competente</p>
        <p class="text-sm opacity-70">Alineada a UABC + Tec · Mejorada con proyectos reales</p>
      </aside>
    </footer>

    <script>
      import { initProgressFromSeed } from '../lib/progress-client';
      initProgressFromSeed();
    </script>
  </body>
</html>
