---
import '../styles/global.css';
import { getCatalog, getLeccionesCatalog } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Plan', description = 'Plan personal de ingeniería de software' } = Astro.props;
const fullTitle = title === 'Plan' ? 'Plan de Ingeniería de Software' : `${title} · Plan`;
const catalogIds = getCatalog().materias.map((m) => m.id);
const leccionesCatalog = getLeccionesCatalog();
const continuarFallback = pathTo('materia/M01/leccion/L01');
---

<!doctype html>
<html lang="es" data-theme="corporate">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Plan" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={pathTo('favicon.svg')} />
    <link rel="apple-touch-icon" href={pathTo('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={pathTo('manifest.webmanifest')} />
    <script src="../pwa.ts"></script>
  </head>
  <body class="min-h-screen bg-base-200">
    <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100">
      <div class="navbar min-h-14 px-3 sm:px-4 gap-2 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-1 min-w-0 shrink-0">
          <div class="dropdown dropdown-bottom lg:hidden">
            <div tabindex="0" role="button" class="btn btn-ghost btn-square btn-sm" aria-label="Menú">☰</div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-72 max-w-[calc(100vw-1.5rem)] max-h-[70vh] overflow-y-auto p-2 shadow border border-base-300"
            >
              <li class="menu-title"><span>Etapas</span></li>
              <li><a href={pathTo()}>Inicio</a></li>
              <li><a href={pathTo('etapa/basica')}>Básica</a></li>
              <li><a href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
              <li><a href={pathTo('etapa/terminal')}>Terminal</a></li>
              <li><a href={pathTo('progreso')}>Progreso</a></li>
              <li class="menu-title"><span>Guías</span></li>
              <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
              <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
              <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
              <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
              <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
              <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
              <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
              <li><a href={pathTo('egreso')}>Egreso</a></li>
              <li><a href={pathTo('nivel')}>Nivel</a></li>
              <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
            </ul>
          </div>
          <a class="btn btn-ghost px-2 text-base font-bold tracking-tight" href={pathTo()}>Plan</a>
        </div>

        <nav class="hidden lg:flex flex-1 items-center justify-center min-w-0" aria-label="Principal">
          <ul class="flex items-center gap-0.5 text-sm flex-nowrap">
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/basica')}>Básica</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/disciplinaria')}>Disciplinaria</a></li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('etapa/terminal')}>Terminal</a></li>
            <li>
              <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost btn-sm font-normal">Guías ▾</div>
                <ul
                  tabindex="0"
                  class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-52 p-2 shadow border border-base-300"
                >
                  <li><a href={pathTo('docs/como-estudiar')}>Cómo estudiar</a></li>
                  <li><a href={pathTo('docs/instalar-iphone')}>Instalar en iPhone</a></li>
                  <li><a href={pathTo('docs/glosario')}>Glosario</a></li>
                  <li><a href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
                  <li><a href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
                  <li><a href={pathTo('docs/producto')}>Hilo producto</a></li>
                  <li><a href={pathTo('docs/filosofia')}>Filosofía</a></li>
                  <li><a href={pathTo('egreso')}>Egreso</a></li>
                  <li><a href={pathTo('nivel')}>Nivel</a></li>
                  <li><a href={pathTo('docs/index')}>Mapa curricular</a></li>
                </ul>
              </div>
            </li>
            <li><a class="btn btn-ghost btn-sm font-normal" href={pathTo('progreso')}>Progreso</a></li>
          </ul>
        </nav>

        <div class="flex items-center gap-2 shrink-0 ml-auto lg:ml-0">
          <a
            class="btn btn-primary btn-sm"
            data-continuar
            href={continuarFallback}
            title="Última materia o siguiente incompleta"
          >
            Continuar
          </a>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-3 sm:px-4 py-6 sm:py-8 max-w-6xl w-full min-w-0">
      <slot />
    </main>

    <footer class="footer footer-center bg-base-100 text-base-content p-6 border-t border-base-300">
      <aside class="max-w-prose px-2">
        <p class="font-medium">Plan de Ingeniería de Software</p>
        <p class="text-sm opacity-70">Mejorado con proyectos reales y evidencia en git</p>
      </aside>
    </footer>

    <script type="application/json" id="catalog-ids" set:html={JSON.stringify(catalogIds)} />
    <script type="application/json" id="lecciones-catalog" set:html={JSON.stringify(leccionesCatalog)} />

    <script>
      import { initProgressFromSeed, resolveContinuePath } from '../lib/progress-client';
      import { pathTo } from '../lib/paths';

      initProgressFromSeed();

      function syncContinuar() {
        const raw = document.getElementById('catalog-ids')?.textContent;
        const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
        let ids: string[] = [];
        let leccionesByMateria: Record<string, string[]> = {};
        try {
          ids = raw ? (JSON.parse(raw) as string[]) : [];
        } catch {
          ids = ['M01'];
        }
        try {
          leccionesByMateria = lecRaw
            ? (JSON.parse(lecRaw) as Record<string, string[]>)
            : {};
        } catch {
          leccionesByMateria = {};
        }
        const rel = resolveContinuePath(ids, leccionesByMateria);
        const href = pathTo(rel);
        const materiaId = rel.split('/')[1] ?? 'M01';
        const narrow = window.matchMedia('(max-width: 1023px)').matches;
        document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((a) => {
          a.href = href;
          // En móvil el label corto evita que pelee con el brand.
          a.textContent = narrow || materiaId === 'M01' ? 'Continuar' : `Continuar ${materiaId}`;
        });
      }

      syncContinuar();
      window.addEventListener('academia-progress', syncContinuar);
      window.addEventListener('resize', syncContinuar);
    </script>
  </body>
</html>
