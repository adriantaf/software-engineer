---
import { pathTo } from '../lib/paths';

interface Props {
  id: string;
  titulo: string;
  objetivo: string;
  orden: number;
  materiaCount: number;
  horas: number;
  duracionMeses: string;
}

const { id, titulo, objetivo, orden, materiaCount, horas, duracionMeses } = Astro.props;

const metaById: Record<string, { label: string; hint: string }> = {
  basica: { label: 'Cimientos', hint: 'Lenguaje, git y bases' },
  disciplinaria: { label: 'Oficio', hint: 'Producto y sistemas' },
  terminal: { label: 'Salida', hint: 'Producción y egreso' },
};
const meta = metaById[id] ?? { label: `Etapa ${orden}`, hint: objetivo };
---

<a
  class="etapa-card"
  href={pathTo(`etapa/${id}`)}
  data-etapa={id}
  data-etapa-card={id}
>
  <span class="etapa-card__rail" aria-hidden="true" />
  <div class="etapa-card__top">
    <p class="etapa-card__meta">
      <span class="etapa-card__meta-label">{meta.label}</span>
      <span class="etapa-card__meta-sep" aria-hidden="true">·</span>
      <span>Etapa {orden}</span>
    </p>
    <span class="etapa-card__status" data-etapa-label={id}>0%</span>
  </div>
  <h3 class="etapa-card__title">{titulo}</h3>
  <p class="etapa-card__desc">{objetivo}</p>
  <p class="etapa-card__stats">
    {materiaCount} materias · ~{duracionMeses} meses · {horas} h
    <span class="etapa-card__hint"> · {meta.hint}</span>
  </p>
  <progress
    class="progress progress-primary progress-atelier etapa-card__progress"
    data-etapa={id}
    value="0"
    max="100"
    aria-hidden="true"
  />
</a>
