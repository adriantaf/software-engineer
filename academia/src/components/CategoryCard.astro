---
import { pathTo } from '../lib/paths';

interface Props {
  id: string;
  titulo: string;
  objetivo: string;
  orden: number;
  materiaCount: number;
  horas: number;
  duracionMeses: string;
}

const { id, titulo, objetivo, orden, materiaCount, horas, duracionMeses } = Astro.props;
const accent =
  id === 'basica'
    ? 'var(--color-plan-basica)'
    : id === 'disciplinaria'
      ? 'var(--color-plan-disciplinaria)'
      : 'var(--color-plan-terminal)';
---

<a
  class="category-card"
  style={`--accent: ${accent}`}
  href={pathTo(`etapa/${id}`)}
  data-etapa-card={id}
>
  <div class="category-card__top">
    <span class="category-card__stage">Etapa {orden}</span>
    <span class="category-card__pct" data-etapa-label={id}>0%</span>
  </div>
  <h3 class="category-card__title">{titulo}</h3>
  <p class="category-card__desc">{objetivo}</p>
  <p class="category-card__stats">
    {materiaCount} materias · ~{duracionMeses} meses · {horas} h
  </p>
  <progress
    class="progress progress-primary category-card__progress"
    data-etapa={id}
    value="0"
    max="100"
  ></progress>
</a>
