---
import { pathTo } from '../lib/paths';

interface Props {
  programa: string;
  ritmoHoras: number;
  materias: number;
  horas: number;
  semanas: number;
  continuarHref: string;
}

const { programa, ritmoHoras, materias, horas, semanas, continuarHref } = Astro.props;
---

<section class="home-hero">
  <div class="plan-shell relative z-[1] py-12 sm:py-16 lg:py-20">
    <p class="font-display text-sm sm:text-base font-semibold tracking-[0.2em] uppercase text-teal-200/90 m-0 mb-3">
      Plan
    </p>
    <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight max-w-3xl m-0 leading-[1.15]">
      {programa}
    </h1>
    <p class="text-base sm:text-lg text-slate-200/90 max-w-xl m-0 mt-4 leading-relaxed">
      Ritmo recomendado <strong class="text-white">{ritmoHoras} h/semana</strong>
      <span class="opacity-50"> · </span>
      {materias} materias · ~{horas} h · ~{semanas} semanas
    </p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a class="plan-btn-cta" data-continuar data-continuar-keep-label href={continuarHref}>Continuar aprendiendo</a>
      <a class="plan-btn-ghost" href={pathTo('docs/como-estudiar')}>Cómo estudiar</a>
    </div>
  </div>
</section>
