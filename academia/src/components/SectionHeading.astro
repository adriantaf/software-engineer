---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkLabel?: string;
}

const { title, subtitle, href, linkLabel = 'Ver todo' } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
  <div class="min-w-0">
    <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight m-0">{title}</h2>
    {subtitle && <p class="text-sm text-plan-muted m-0 mt-1">{subtitle}</p>}
  </div>
  {
    href && (
      <a class="text-sm font-semibold text-plan-primary hover:underline shrink-0" href={href}>
        {linkLabel} →
      </a>
    )
  }
</div>
