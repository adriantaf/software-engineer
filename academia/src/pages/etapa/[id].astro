---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CourseCard from '../../components/CourseCard.astro';
import CourseGrid from '../../components/CourseGrid.astro';
import {
  getCatalog,
  getEtapa,
  getLeccionesCatalog,
  getMateriasByEtapa,
  loadEtapaExamen,
} from '../../lib/curriculum';
import { pathTo } from '../../lib/paths';

export function getStaticPaths() {
  return getCatalog().etapas.map((e) => ({ params: { id: e.id } }));
}

const { id } = Astro.params;
const etapa = getEtapa(id!);
if (!etapa) {
  throw new Error('Etapa no encontrada');
}
const materias = getMateriasByEtapa(etapa.id);
const tieneExamen = Boolean(loadEtapaExamen(etapa.id));
const ultima = materias[materias.length - 1];
const leccionesByMateria = getLeccionesCatalog();
const horas = materias.reduce((a, m) => a + m.horas, 0);
const accent =
  etapa.id === 'basica'
    ? 'var(--color-plan-basica)'
    : etapa.id === 'disciplinaria'
      ? 'var(--color-plan-disciplinaria)'
      : 'var(--color-plan-terminal)';
---

<Layout title={etapa.titulo}>
  <div class="plan-shell py-8 sm:py-10">
    <div class="breadcrumbs text-sm mb-5">
      <ul>
        <li><a href={pathTo()}>Inicio</a></li>
        <li>{etapa.titulo}</li>
      </ul>
    </div>

    <header
      class="mb-8 pb-6 border-b border-plan-border"
      style={`border-top: 3px solid ${accent}; padding-top: 1.25rem`}
    >
      <p class="text-xs font-semibold uppercase tracking-wider text-plan-muted m-0 mb-2">
        Etapa {etapa.orden}
      </p>
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight m-0">{etapa.titulo}</h1>
      <p class="text-base text-plan-muted max-w-2xl m-0 mt-3 leading-relaxed">{etapa.objetivo}</p>
      <p class="text-sm text-plan-muted m-0 mt-3">
        {materias.length} materias · ~{etapa.duracionMeses} meses · {horas} h @ ≥20 h/semana
      </p>
      {
        tieneExamen && (
          <div class="mt-4">
            <a class="btn btn-outline btn-sm" href={pathTo(`etapa/${etapa.id}/examen`)}>
              Autoevaluación de etapa →
            </a>
          </div>
        )
      }
    </header>

    <SectionHeading title="Materias" subtitle="Abre una ficha para ver lecciones y checklist." />
    <CourseGrid>
      {
        materias.map((m) => (
          <div class="relative">
            <CourseCard
              id={m.id}
              titulo={m.titulo}
              etapaId={m.etapa}
              etapaTitulo={etapa.titulo}
              horas={m.horas}
              semanas={m.semanas}
              leccionCount={leccionesByMateria[m.id]?.length ?? 0}
            />
            <span
              class="badge badge-ghost absolute top-2 right-2 z-10 text-[0.65rem]"
              data-status={m.id}
            >
              —
            </span>
          </div>
        ))
      }
    </CourseGrid>

    {
      tieneExamen && (
        <div class="mt-10 rounded-[var(--radius-plan)] border border-plan-border bg-white p-5 sm:p-6 shadow-[var(--shadow-plan)]">
          <p class="font-display font-semibold m-0 text-lg">Cierre de etapa</p>
          <p class="m-0 mt-2 text-sm text-plan-muted leading-relaxed">
            Al concluir{' '}
            {ultima ? (
              <>
                <span class="opacity-70">#{ultima.orden}</span> {ultima.titulo}
              </>
            ) : (
              'la última materia'
            )}
            , realiza la autoevaluación sin consultar las fichas.
          </p>
          <a class="plan-btn-cta mt-4 inline-flex" href={pathTo(`etapa/${etapa.id}/examen`)}>
            Abrir autoevaluación
          </a>
        </div>
      )
    }
  </div>

  <script>
    import { loadProgress } from '../../lib/progress-client';

    const map: Record<string, string> = {
      completada: 'badge-success',
      en_curso: 'badge-warning',
      disponible: 'badge-info',
      bloqueada: 'badge-ghost',
    };

    function refresh() {
      const p = loadProgress();
      document.querySelectorAll('[data-status]').forEach((el) => {
        const id = el.getAttribute('data-status')!;
        const status = p?.materias?.[id]?.status ?? 'disponible';
        el.className = `badge absolute top-2 right-2 z-10 text-[0.65rem] ${map[status] ?? 'badge-ghost'}`;
        el.textContent = status.replace('_', ' ');
      });
    }
    refresh();
    window.addEventListener('academia-progress', refresh);
  </script>
</Layout>
