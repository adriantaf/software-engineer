---
import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
import {
  getCatalog,
  getEtapa,
  getMateriasByEtapa,
  listLecciones,
  loadEtapaExamen,
} from '../../lib/curriculum';
import { pathTo } from '../../lib/paths';

export function getStaticPaths() {
  return getCatalog().etapas.map((e) => ({ params: { id: e.id } }));
}

const { id } = Astro.params;
const etapa = getEtapa(id!);
if (!etapa) {
  throw new Error('Etapa no encontrada');
}
const materias = getMateriasByEtapa(etapa.id);
const tieneExamen = Boolean(loadEtapaExamen(etapa.id));
const ultima = materias[materias.length - 1];
---

<Layout title={etapa.titulo}>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><a href={pathTo()}>Inicio</a></li>
      <li>{etapa.titulo}</li>
    </ul>
  </div>

  <header class="mb-6 min-w-0">
    <p class="text-xs font-semibold tracking-widest uppercase text-primary m-0 mb-2">Etapa {etapa.orden}</p>
    <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight break-words m-0 mb-2">{etapa.titulo}</h1>
    <p class="break-words m-0 mb-1">{etapa.objetivo}</p>
    <p class="text-sm opacity-70 m-0">Duración estimada: {etapa.duracionMeses} meses @ ≥20 h/semana</p>
    <div class="mt-3 flex flex-wrap gap-2">
      <a class="btn btn-ghost btn-sm" href={pathTo(`docs/etapa-${etapa.id}`)}>
        README de etapa
      </a>
      {
        tieneExamen && (
          <a class="btn btn-outline btn-sm" href={pathTo(`etapa/${etapa.id}/examen`)}>
            Autoevaluación de etapa →
          </a>
        )
      }
      <a class="btn btn-outline btn-sm" href={pathTo('revision')}>Revisión de emergencia</a>
    </div>
  </header>

  <div class="course-grid mb-8">
    {
      materias.map((m) => (
        <div class="relative">
          <CourseCard
            id={m.id}
            titulo={m.titulo}
            etapaId={etapa.id}
            etapaTitulo={etapa.titulo}
            horas={m.horas}
            semanas={m.semanas}
            leccionCount={listLecciones(m.id).length}
          />
          <span
            class="status-chip status-chip--muted absolute top-2 right-2 z-[1] bg-base-100/90"
            data-status={m.id}
          >
            —
          </span>
        </div>
      ))
    }
  </div>

  {
    tieneExamen && (
      <div class="callout-atelier mt-6 text-sm sm:text-base min-w-0">
        <p class="font-display font-semibold m-0 mb-1">Cierre de etapa</p>
        <p class="m-0 opacity-80 break-words">
          Cuando termines{' '}
          {ultima ? (
            <>
              <span class="opacity-70">#{ultima.orden}</span> {ultima.titulo}
            </>
          ) : (
            'la última materia'
          )}
          , haz la autoevaluación sin mirar las fichas.
        </p>
        <a class="btn btn-primary btn-sm mt-3" href={pathTo(`etapa/${etapa.id}/examen`)}>
          Abrir autoevaluación
        </a>
      </div>
    )
  }

  <script>
    import { loadProgress } from '../../lib/progress-client';

    const map: Record<string, string> = {
      completada: 'status-chip status-chip--ok',
      en_curso: 'status-chip status-chip--warn',
      disponible: 'status-chip status-chip--info',
      bloqueada: 'status-chip status-chip--muted',
    };

    function refresh() {
      const p = loadProgress();
      document.querySelectorAll('[data-status]').forEach((el) => {
        const id = el.getAttribute('data-status')!;
        const status = p?.materias?.[id]?.status ?? 'disponible';
        el.className = map[status] ?? 'status-chip status-chip--muted';
        el.textContent = status.replace('_', ' ');
      });
    }
    refresh();
    window.addEventListener('academia-progress', refresh);
  </script>
</Layout>
