---
import Layout from '../../../layouts/Layout.astro';
import {
  getCatalog,
  getEtapa,
  loadEtapaExamen,
  splitExamenSections,
} from '../../../lib/curriculum';
import { getExamenRubrica } from '../../../lib/examen-rubrica';
import { pathTo } from '../../../lib/paths';

export function getStaticPaths() {
  const paths = [];
  for (const e of getCatalog().etapas) {
    const exam = loadEtapaExamen(e.id);
    if (exam) {
      paths.push({
        params: { id: e.id },
        props: {
          exam,
          sections: splitExamenSections(exam.html),
          rubrica: getExamenRubrica(e.id),
        },
      });
    }
  }
  return paths;
}

const { id } = Astro.params;
const etapa = getEtapa(id!);
const { exam, sections, rubrica } = Astro.props;
if (!etapa || !exam) throw new Error('Examen de etapa no encontrado');
---

<Layout title={`Autoevaluación · ${etapa.titulo}`}>
  <div class="breadcrumbs text-sm mb-4 max-w-full overflow-x-auto">
    <ul class="flex-wrap">
      <li><a href={pathTo()}>Inicio</a></li>
      <li><a href={pathTo(`etapa/${etapa.id}`)}>{etapa.titulo}</a></li>
      <li>Autoevaluación</li>
    </ul>
  </div>

  <h1 class="page-title">Autoevaluación · {etapa.titulo}</h1>
  <div class="callout-atelier mb-6 text-sm sm:text-base" role="status">
    <p class="font-semibold m-0 mb-1">Sin mirar fichas</p>
    <p class="m-0 opacity-80">
      Escribe respuestas y marca la rúbrica. Todo se guarda en este navegador (clave
      <code>examenes</code> al exportar desde Progreso). No hay nota automática.
    </p>
  </div>

  <div id="examen-root" data-etapa={etapa.id} class="flex flex-col gap-6 max-w-3xl">
    {
      sections.map((sec) => (
        <section class="surface-panel p-4 sm:p-5" data-section={sec.id}>
          <div class="prose-academia mb-4" set:html={sec.html} />
          {
            sec.id !== 'intro' && (
              <label class="form-control w-full">
                <span class="label-text text-sm font-medium mb-1">Tu respuesta — {sec.title}</span>
                <textarea
                  class="textarea textarea-bordered w-full min-h-32 text-sm"
                  data-exam-answer={sec.id}
                  rows={6}
                  placeholder="Escribe o pega notas / esquema / enlace a grabación…"
                />
              </label>
            )
          }
        </section>
      ))
    }

    {
      rubrica && (
        <section class="surface-panel p-4 sm:p-5" aria-labelledby="rubrica-title">
          <h2 id="rubrica-title" class="font-display text-xl font-semibold m-0 mb-1">
            {rubrica.titulo}
          </h2>
          <p class="text-sm opacity-80 m-0 mb-4">{rubrica.criterio}</p>
          <ul class="flex flex-col gap-2 list-none p-0 m-0">
            {rubrica.items.map((item) => (
              <li>
                <label class="flex items-start gap-3 cursor-pointer text-sm leading-snug">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-primary mt-0.5 shrink-0"
                    data-rubrica={item.id}
                  />
                  <span>{item.label}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="text-sm m-0 mt-4" id="rubrica-count" aria-live="polite"></p>
        </section>
      )
    }

    <label class="flex items-start gap-3 surface-panel p-4 cursor-pointer">
      <input type="checkbox" class="checkbox checkbox-primary mt-0.5" id="examen-listo" />
      <span class="text-sm leading-snug">
        Listo para comparar con el criterio de aprobado (honestidad &gt; marcar todo).
      </span>
    </label>

    <p id="examen-saved" class="text-sm opacity-70 m-0" aria-live="polite"></p>
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    <a class="btn btn-outline btn-sm" href={pathTo(`etapa/${etapa.id}`)}>← Volver a {etapa.titulo}</a>
    <a class="btn btn-primary btn-sm" href={pathTo('progreso')}>Check-in semanal →</a>
  </div>

  <script>
    import {
      loadProgress,
      saveProgress,
      type ProgressState,
    } from '../../../lib/progress-client';

    const root = document.getElementById('examen-root');
    const etapaId = root?.getAttribute('data-etapa');
    const savedEl = document.getElementById('examen-saved');
    const countEl = document.getElementById('rubrica-count');
    if (!root || !etapaId) throw new Error('examen root');

    function emptyProgress(): ProgressState {
      return {
        estudiante: 'Adrian Tafoya',
        inicio: new Date().toISOString().slice(0, 10),
        horasSemanalesMeta: 20,
        materiaActual: 'M01',
        materias: {},
        notas: [],
        checkIns: [],
        examenes: {},
      };
    }

    function syncRubricaCount() {
      const boxes = root.querySelectorAll<HTMLInputElement>('input[data-rubrica]');
      if (!boxes.length || !countEl) return;
      const done = [...boxes].filter((b) => b.checked).length;
      countEl.textContent = `Rúbrica: ${done}/${boxes.length} criterios marcados`;
    }

    function persist() {
      const state = loadProgress() ?? emptyProgress();
      const answers: Record<string, string> = {};
      root.querySelectorAll<HTMLTextAreaElement>('[data-exam-answer]').forEach((el) => {
        const id = el.getAttribute('data-exam-answer')!;
        answers[id] = el.value;
      });
      const rubrica: Record<string, boolean> = {};
      root.querySelectorAll<HTMLInputElement>('input[data-rubrica]').forEach((el) => {
        const id = el.getAttribute('data-rubrica')!;
        rubrica[id] = el.checked;
      });
      const listo = Boolean(
        (document.getElementById('examen-listo') as HTMLInputElement | null)?.checked,
      );
      state.examenes = {
        ...(state.examenes ?? {}),
        [etapaId]: {
          updatedAt: new Date().toISOString(),
          listo,
          answers,
          rubrica,
        },
      };
      saveProgress(state);
      syncRubricaCount();
      if (savedEl) {
        savedEl.textContent = `Guardado local · ${new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })}`;
      }
    }

    function hydrate() {
      const entry = loadProgress()?.examenes?.[etapaId];
      if (!entry) {
        syncRubricaCount();
        return;
      }
      root.querySelectorAll<HTMLTextAreaElement>('[data-exam-answer]').forEach((el) => {
        const id = el.getAttribute('data-exam-answer')!;
        if (entry.answers?.[id]) el.value = entry.answers[id];
      });
      root.querySelectorAll<HTMLInputElement>('input[data-rubrica]').forEach((el) => {
        const id = el.getAttribute('data-rubrica')!;
        el.checked = Boolean(entry.rubrica?.[id]);
      });
      const box = document.getElementById('examen-listo') as HTMLInputElement | null;
      if (box) box.checked = Boolean(entry.listo);
      syncRubricaCount();
      if (savedEl && entry.updatedAt) {
        savedEl.textContent = `Última edición local · ${new Date(entry.updatedAt).toLocaleString('es-MX')}`;
      }
    }

    hydrate();
    let t: ReturnType<typeof setTimeout> | undefined;
    root.addEventListener('input', () => {
      if (t) clearTimeout(t);
      t = setTimeout(persist, 400);
    });
    root.addEventListener('change', persist);
  </script>
</Layout>
