---
import Layout from '../../layouts/Layout.astro';
import { loadMarkdownPage } from '../../lib/curriculum';

export function getStaticPaths() {
  return [
    { params: { slug: 'index' }, props: { file: 'INDEX.md' } },
    { params: { slug: 'como-estudiar' }, props: { file: 'como-estudiar.md' } },
    { params: { slug: 'filosofia' }, props: { file: 'filosofia.md' } },
    { params: { slug: 'producto-saas' }, props: { file: 'producto-saas.md' } },
    { params: { slug: 'bibliografia' }, props: { file: 'bibliografia.md' } },
    { params: { slug: 'glosario' }, props: { file: 'glosario.md' } },
    { params: { slug: 'seguridad' }, props: { file: 'hilos/seguridad.md' } },
    { params: { slug: 'producto' }, props: { file: 'hilos/producto.md' } },
  ];
}

const { file } = Astro.props;
const page = loadMarkdownPage(file);
---

<Layout title={page.title}>
  <div class="plan-shell py-8 sm:py-10">
    <article class="rounded-[var(--radius-plan)] border border-plan-border bg-white overflow-hidden shadow-[var(--shadow-plan)]">
      <div class="p-4 sm:p-6 md:p-8 min-w-0 prose-academia" set:html={page.html} />
    </article>
  </div>
</Layout>
