---
import Layout from '../layouts/Layout.astro';
import { getCatalog, getProgressSeed } from '../lib/curriculum';
import { pathTo } from '../lib/paths';

const catalog = getCatalog();
const seed = getProgressSeed();
const today = new Date().toISOString().slice(0, 10);
---

<Layout title="Progreso">
  <script type="application/json" id="progress-seed" set:html={JSON.stringify(seed)} />

  <h1 class="text-2xl sm:text-3xl font-bold mb-2 break-words">Progreso</h1>
  <p class="mb-6 opacity-80 text-sm sm:text-base break-words">
    Ritmo semanal + avance por materia. El estado vive en <code>localStorage</code>; copia el JSON a
    <code>progress.json</code> y haz commit semanal.
  </p>

  <div class="grid sm:grid-cols-3 gap-4 mb-6">
    <div class="stat bg-base-100 border border-base-300 rounded-box min-w-0 overflow-hidden py-3">
      <div class="stat-title">Completadas</div>
      <div class="stat-value text-primary text-3xl sm:text-4xl" id="stat-done">0</div>
      <div class="stat-desc">de {catalog.materias.length} materias</div>
    </div>
    <div class="stat bg-base-100 border border-base-300 rounded-box min-w-0 overflow-hidden py-3">
      <div class="stat-title">En curso</div>
      <div class="stat-value text-warning text-3xl sm:text-4xl" id="stat-doing">0</div>
      <div class="stat-desc truncate">materia actual: <span id="stat-current">—</span></div>
    </div>
    <div class="stat bg-base-100 border border-base-300 rounded-box min-w-0 overflow-hidden py-3">
      <div class="stat-title">Meta semanal</div>
      <div class="stat-value text-secondary text-3xl sm:text-4xl">
        <span id="stat-meta">{catalog.ritmoHorasSemana}</span>h
      </div>
      <div class="stat-desc flex flex-wrap items-center gap-2 mt-1">
        <label class="flex items-center gap-1 text-xs">
          Ajustar
          <input
            id="input-meta-horas"
            type="number"
            min="1"
            max="80"
            class="input input-bordered input-xs w-16"
            value={catalog.ritmoHorasSemana}
          />
        </label>
      </div>
    </div>
  </div>

  <section class="card bg-base-100 border border-base-300 mb-6 overflow-hidden" aria-labelledby="checkin-title">
    <div class="card-body min-w-0 p-4 sm:p-6 gap-4">
      <div>
        <h2 id="checkin-title" class="card-title text-lg sm:text-xl">Check-in semanal</h2>
        <p class="text-sm opacity-70 m-0">
          ~5 min. Una entrada por fecha; si ya hiciste check-in hoy, se actualiza.
        </p>
      </div>

      <form id="checkin-form" class="grid gap-3 sm:grid-cols-2">
        <label class="form-control w-full sm:col-span-1">
          <span class="label-text text-sm font-medium">Fecha</span>
          <input
            id="checkin-fecha"
            name="fecha"
            type="date"
            class="input input-bordered w-full"
            value={today}
            required
          />
        </label>
        <label class="form-control w-full sm:col-span-1">
          <span class="label-text text-sm font-medium">Horas reales esta semana</span>
          <input
            id="checkin-horas"
            name="horas"
            type="number"
            min="0"
            max="80"
            step="1"
            class="input input-bordered w-full"
            placeholder="ej. 18"
            required
          />
        </label>
        <label class="form-control w-full sm:col-span-2">
          <span class="label-text text-sm font-medium">Qué hice</span>
          <textarea
            id="checkin-hecho"
            name="hecho"
            class="textarea textarea-bordered w-full min-h-20"
            placeholder="Lecciones, prácticas, commits…"
            required
          ></textarea>
        </label>
        <label class="form-control w-full sm:col-span-1">
          <span class="label-text text-sm font-medium">Bloqueo</span>
          <textarea
            id="checkin-bloqueo"
            name="bloqueo"
            class="textarea textarea-bordered w-full min-h-20"
            placeholder="Duda, fatiga, tema que se trabó… (o “ninguno”)"
            required
          ></textarea>
        </label>
        <label class="form-control w-full sm:col-span-1">
          <span class="label-text text-sm font-medium">Siguiente paso</span>
          <textarea
            id="checkin-siguiente"
            name="siguiente"
            class="textarea textarea-bordered w-full min-h-20"
            placeholder="Primera acción de la próxima sesión"
            required
          ></textarea>
        </label>
        <div class="sm:col-span-2 flex flex-wrap items-center gap-2">
          <button class="btn btn-primary btn-sm sm:btn-md" type="submit">Guardar check-in</button>
          <p id="checkin-status" class="text-sm opacity-70 m-0" aria-live="polite"></p>
        </div>
      </form>

      <div>
        <h3 class="font-semibold text-sm mb-2">Últimos check-ins</h3>
        <ul id="checkin-list" class="space-y-2 text-sm"></ul>
        <p id="checkin-empty" class="text-sm opacity-60 m-0">Aún no hay check-ins. El primero cuenta.</p>
      </div>
    </div>
  </section>

  <div class="card bg-base-100 border border-base-300 mb-6 overflow-hidden">
    <div class="card-body min-w-0 p-4 sm:p-6">
      <h2 class="card-title">Exportar / importar</h2>
      <p class="text-sm opacity-70 m-0 mb-2">
        Incluye check-ins. Pega en <code>progress.json</code> y haz commit semanal.
      </p>
      <textarea id="export-box" class="textarea textarea-bordered font-mono text-xs h-48 w-full max-w-full min-w-0 overflow-x-auto"></textarea>
      <div class="card-actions justify-end flex-wrap">
        <button class="btn btn-outline btn-sm sm:btn-md" id="btn-refresh" type="button">Refrescar</button>
        <button class="btn btn-outline btn-sm sm:btn-md" id="btn-copy" type="button">Copiar</button>
        <button class="btn btn-primary btn-sm sm:btn-md" id="btn-import" type="button">Importar JSON</button>
      </div>
    </div>
  </div>

  <section class="mb-6" aria-labelledby="examenes-title">
    <h2 id="examenes-title" class="text-lg font-semibold mb-2">Autoevaluaciones de etapa</h2>
    <div class="flex flex-wrap gap-2">
      {
        catalog.etapas.map((e) => (
          <a class="btn btn-outline btn-sm" href={pathTo(`etapa/${e.id}/examen`)}>
            {e.titulo}
          </a>
        ))
      }
    </div>
  </section>

  <div class="overflow-x-auto max-w-full rounded-box border border-base-300 bg-base-100">
    <table class="table table-sm sm:table-md">
      <thead>
        <tr>
          <th>ID</th>
          <th>Materia</th>
          <th>Etapa</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        {
          catalog.materias.map((m) => (
            <tr>
              <td class="font-mono">
                <a class="link" href={pathTo(`materia/${m.id}`)}>
                  {m.id}
                </a>
              </td>
              <td class="min-w-[10rem] break-words whitespace-normal">{m.titulo}</td>
              <td>{m.etapa}</td>
              <td><span class="badge whitespace-nowrap" data-row-status={m.id}>—</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script>
    import {
      loadProgress,
      saveProgress,
      exportProgressJson,
      addWeeklyCheckIn,
      setHorasSemanalesMeta,
      initProgressFromSeed,
    } from '../lib/progress-client';
    import type { ProgressState, WeeklyCheckIn } from '../lib/progress-client';

    initProgressFromSeed();

    const map: Record<string, string> = {
      completada: 'badge-success',
      en_curso: 'badge-warning',
      disponible: 'badge-info',
      bloqueada: 'badge-ghost',
    };

    function escapeHtml(s: string) {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderCheckIns(list: WeeklyCheckIn[]) {
      const ul = document.getElementById('checkin-list');
      const empty = document.getElementById('checkin-empty');
      if (!ul || !empty) return;
      ul.innerHTML = '';
      if (!list.length) {
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');
      for (const c of list.slice(0, 8)) {
        const li = document.createElement('li');
        li.className = 'border border-base-300 rounded-box p-3 bg-base-200/40';
        li.innerHTML = `
          <div class="flex flex-wrap gap-2 items-baseline mb-1">
            <span class="font-mono text-xs opacity-70">${escapeHtml(c.fecha)}</span>
            <span class="badge badge-sm badge-secondary">${c.horas}h</span>
          </div>
          <p class="m-0"><span class="font-medium">Hecho:</span> ${escapeHtml(c.hecho)}</p>
          <p class="m-0"><span class="font-medium">Bloqueo:</span> ${escapeHtml(c.bloqueo)}</p>
          <p class="m-0"><span class="font-medium">Siguiente:</span> ${escapeHtml(c.siguiente)}</p>
        `;
        ul.appendChild(li);
      }
    }

    function refresh() {
      const p = loadProgress();
      const materias = Object.values(p?.materias ?? {});
      const done = materias.filter((m) => m.status === 'completada').length;
      const doing = materias.filter((m) => m.status === 'en_curso').length;
      const doneEl = document.getElementById('stat-done');
      const doingEl = document.getElementById('stat-doing');
      const currentEl = document.getElementById('stat-current');
      const metaEl = document.getElementById('stat-meta');
      const metaInput = document.getElementById('input-meta-horas') as HTMLInputElement | null;
      const box = document.getElementById('export-box') as HTMLTextAreaElement;
      if (doneEl) doneEl.textContent = String(done);
      if (doingEl) doingEl.textContent = String(doing);
      if (currentEl) currentEl.textContent = p?.materiaActual ?? '—';
      if (metaEl) metaEl.textContent = String(p?.horasSemanalesMeta ?? 20);
      if (metaInput && document.activeElement !== metaInput) {
        metaInput.value = String(p?.horasSemanalesMeta ?? 20);
      }
      if (box) box.value = exportProgressJson();
      renderCheckIns(p?.checkIns ?? []);

      document.querySelectorAll('[data-row-status]').forEach((el) => {
        const id = el.getAttribute('data-row-status')!;
        const status = p?.materias?.[id]?.status ?? 'disponible';
        el.className = `badge ${map[status] ?? 'badge-ghost'}`;
        el.textContent = status.replace('_', ' ');
      });
    }

    document.getElementById('checkin-form')?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fecha = (document.getElementById('checkin-fecha') as HTMLInputElement).value;
      const horas = Number((document.getElementById('checkin-horas') as HTMLInputElement).value);
      const hecho = (document.getElementById('checkin-hecho') as HTMLTextAreaElement).value;
      const bloqueo = (document.getElementById('checkin-bloqueo') as HTMLTextAreaElement).value;
      const siguiente = (document.getElementById('checkin-siguiente') as HTMLTextAreaElement).value;
      addWeeklyCheckIn({ fecha, horas, hecho, bloqueo, siguiente });
      const status = document.getElementById('checkin-status');
      if (status) status.textContent = 'Check-in guardado. Recuerda exportar a progress.json.';
      (document.getElementById('checkin-horas') as HTMLInputElement).value = '';
      (document.getElementById('checkin-hecho') as HTMLTextAreaElement).value = '';
      (document.getElementById('checkin-bloqueo') as HTMLTextAreaElement).value = '';
      (document.getElementById('checkin-siguiente') as HTMLTextAreaElement).value = '';
      refresh();
    });

    document.getElementById('input-meta-horas')?.addEventListener('change', (ev) => {
      const v = Number((ev.target as HTMLInputElement).value);
      setHorasSemanalesMeta(v);
      refresh();
    });

    document.getElementById('btn-refresh')?.addEventListener('click', refresh);
    document.getElementById('btn-copy')?.addEventListener('click', async () => {
      const box = document.getElementById('export-box') as HTMLTextAreaElement;
      await navigator.clipboard.writeText(box.value);
    });
    document.getElementById('btn-import')?.addEventListener('click', () => {
      const box = document.getElementById('export-box') as HTMLTextAreaElement;
      try {
        const parsed = JSON.parse(box.value) as ProgressState;
        saveProgress(parsed);
        refresh();
        alert('Progreso importado en este navegador.');
      } catch {
        alert('JSON inválido.');
      }
    });

    refresh();
    window.addEventListener('academia-progress', refresh);
  </script>
</Layout>
