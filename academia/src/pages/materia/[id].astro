---
import Layout from '../../layouts/Layout.astro';
import MateriaCover from '../../components/MateriaCover.astro';
import { getCatalog, getEtapa, loadMateria } from '../../lib/curriculum';
import { gradientForEtapa } from '../../lib/materia-gradients';
import { pathTo } from '../../lib/paths';

export function getStaticPaths() {
  return getCatalog().materias.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const materia = loadMateria(id!);
if (!materia) throw new Error(`Materia ${id} no encontrada`);
const etapa = getEtapa(materia.etapa)!;
const catalog = getCatalog();
const idx = catalog.materias.findIndex((m) => m.id === materia.id);
const prev = catalog.materias[idx - 1];
const next = catalog.materias[idx + 1];
const hasLecciones = materia.lecciones.length > 0;
const firstLeccion = materia.lecciones[0];
const hasDia1 = !hasLecciones && /día\s*1|dia\s*1/i.test(materia.bodyHtml);

const [mediaFrom, mediaTo] = gradientForEtapa(etapa.id);
---

<Layout title={`${materia.id} ${materia.titulo}`}>
  <div class="materia-hero w-full" style={`--media-from: ${mediaFrom}; --media-to: ${mediaTo}`}>
    <MateriaCover id={materia.id} etapaId={etapa.id} variant="hero" titulo={materia.titulo} />
    <div class="plan-shell py-8 sm:py-10 text-white materia-hero__content">
      <div class="breadcrumbs text-sm mb-4 opacity-80 [&_a]:text-white [&_a]:opacity-90">
        <ul class="flex-wrap">
          <li><a href={pathTo()}>Inicio</a></li>
          <li><a href={pathTo(`etapa/${etapa.id}`)}>{etapa.titulo}</a></li>
          <li>{materia.id}</li>
        </ul>
      </div>
      <p class="text-xs font-semibold uppercase tracking-wider text-white/70 m-0 mb-2">{etapa.titulo}</p>
      <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight m-0 leading-tight">
        {materia.id} · {materia.titulo}
      </h1>
      <p class="text-sm sm:text-base text-white/85 m-0 mt-3 flex flex-wrap gap-x-3 gap-y-1">
        <span>{materia.semanas} semanas</span>
        <span aria-hidden="true">·</span>
        <span>{materia.horas} horas</span>
        {
          hasLecciones && (
            <>
              <span aria-hidden="true">·</span>
              <span>{materia.lecciones.length} lecciones</span>
            </>
          )
        }
      </p>
      {
        hasLecciones && firstLeccion && (
          <a
            class="plan-btn-cta mt-6 inline-flex"
            href={pathTo(`materia/${materia.id}/leccion/${firstLeccion.id}`)}
          >
            Abrir {firstLeccion.id}
          </a>
        )
      }
    </div>
  </div>

  <div class="plan-shell py-8 sm:py-10">
    <div class="flex flex-col lg:flex-row gap-8 min-w-0">
      <article class="flex-1 min-w-0">
        <p class="text-sm text-plan-muted m-0 mb-5">
          Sigla en teal →
          <a class="link link-primary" href={pathTo('docs/glosario')}>glosario</a>
          (primera vez: expansión entre paréntesis).
        </p>

        {
          hasLecciones && firstLeccion && (
            <div
              role="alert"
              class="mb-6 rounded-[var(--radius-plan)] border border-plan-border bg-plan-primary-soft/40 px-4 py-3 text-sm"
            >
              Empieza por{' '}
              <a
                class="link font-semibold"
                href={pathTo(`materia/${materia.id}/leccion/${firstLeccion.id}`)}
              >
                {firstLeccion.id} — {firstLeccion.titulo}
              </a>
              . Marca cada lección al cumplir “Hecho cuando”.
            </div>
          )
        }

        {
          hasDia1 && (
            <div
              role="alert"
              class="mb-6 rounded-[var(--radius-plan)] border border-plan-border bg-plan-primary-soft/40 px-4 py-3 text-sm"
            >
              Empieza por <strong>Día 1</strong> (2–3 h). Luego temario, lecturas y prácticas.
            </div>
          )
        }

        <div class="prose-academia materia-body min-w-0" set:html={materia.bodyHtml} />
      </article>

      <aside class="w-full lg:w-72 xl:w-80 lg:shrink-0 flex flex-col gap-4 min-w-0 max-w-full lg:sticky lg:top-24 lg:self-start">
        {
          hasLecciones && (
            <nav
              class="rounded-[var(--radius-plan)] border border-plan-border bg-white overflow-hidden min-w-0 shadow-[var(--shadow-plan)]"
              aria-label="Lecciones"
            >
              <div class="flex flex-col gap-2 p-4 min-w-0">
                <h2 class="font-display text-base font-semibold m-0">Lecciones</h2>
                <p class="text-xs text-plan-muted m-0">Marca al terminar cada una.</p>
                <div class="max-h-80 overflow-y-auto overflow-x-hidden min-w-0 pr-1 flex flex-col gap-1">
                  {materia.lecciones.map((l) => (
                    <label class="checklist-item cursor-pointer items-start gap-2 py-1.5">
                      <input
                        type="checkbox"
                        class="checkbox checkbox-primary checkbox-sm mt-0.5 shrink-0"
                        data-leccion={l.id}
                        data-materia={materia.id}
                      />
                      <a
                        class="label-text text-sm leading-snug link link-hover min-w-0"
                        href={pathTo(`materia/${materia.id}/leccion/${l.id}`)}
                      >
                        <span class="font-mono text-xs opacity-70">{l.id}</span>
                        {' '}
                        {l.titulo}
                      </a>
                    </label>
                  ))}
                </div>
              </div>
            </nav>
          )
        }

        {
          materia.toc.length > 0 && (
            <nav
              class="rounded-[var(--radius-plan)] border border-plan-border bg-white overflow-hidden min-w-0 shadow-[var(--shadow-plan)]"
              aria-label="En esta ficha"
            >
              <div class="flex flex-col gap-2 p-4 min-w-0">
                <h2 class="font-display text-base font-semibold m-0">En esta ficha</h2>
                <div class="max-h-64 overflow-y-auto overflow-x-hidden min-w-0 pr-1">
                  <ul class="flex flex-col gap-0.5 m-0 p-0 list-none">
                    {materia.toc.map((item) => (
                      <li class="min-w-0">
                        <a
                          class="block w-full min-w-0 rounded-md px-2 py-1.5 text-sm leading-snug whitespace-normal break-words hover:bg-plan-surface"
                          href={`#${item.id}`}
                        >
                          {item.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <a class="link link-primary text-sm pt-1" href={pathTo('docs/glosario')}>
                  Abrir glosario →
                </a>
              </div>
            </nav>
          )
        }

        <div class="rounded-[var(--radius-plan)] border border-plan-border bg-white overflow-hidden min-w-0 shadow-[var(--shadow-plan)]">
          <div class="flex flex-col gap-3 p-4 min-w-0">
            <h2 class="font-display text-base font-semibold m-0">Tu progreso</h2>
            <p class="text-xs text-plan-muted m-0">
              Se guarda en este navegador. Exporta desde Progreso.
            </p>

            <p class="text-xs font-semibold uppercase tracking-wide text-plan-muted m-0">Prácticas</p>
            {
              materia.practicas.length === 0 ? (
                <p class="text-sm m-0">Sin checklist en frontmatter.</p>
              ) : (
                materia.practicas.map((p) => (
                  <label class="checklist-item cursor-pointer">
                    <input
                      type="checkbox"
                      class="checkbox checkbox-primary checkbox-sm mt-0.5 shrink-0"
                      data-practica={p.id}
                      data-materia={materia.id}
                    />
                    <span class="label-text text-sm">{p.titulo}</span>
                  </label>
                ))
              )
            }

            {
              materia.proyecto && (
                <>
                  <p class="text-xs font-semibold uppercase tracking-wide text-plan-muted m-0 mt-1">
                    Proyecto
                  </p>
                  <label class="checklist-item cursor-pointer">
                    <input
                      type="checkbox"
                      class="checkbox checkbox-secondary checkbox-sm mt-0.5 shrink-0"
                      data-proyecto
                      data-materia={materia.id}
                    />
                    <span class="label-text text-sm">{materia.proyecto.titulo}</span>
                  </label>
                </>
              )
            }

            <p class="text-xs font-semibold uppercase tracking-wide text-plan-muted m-0 mt-1">Materia</p>
            <label class="checklist-item cursor-pointer">
              <input
                type="checkbox"
                class="checkbox checkbox-success checkbox-sm mt-0.5 shrink-0"
                data-completa
                data-materia={materia.id}
              />
              <span class="label-text text-sm font-medium">Completada</span>
            </label>
          </div>
        </div>

        <div class="flex gap-2 w-full min-w-0">
          {
            prev && (
              <a class="btn btn-outline btn-sm flex-1 truncate" href={pathTo(`materia/${prev.id}`)}>
                ← {prev.id}
              </a>
            )
          }
          {
            next && (
              <a class="btn btn-primary btn-sm flex-1 truncate" href={pathTo(`materia/${next.id}`)}>
                {next.id} →
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </div>

  <script>
    import {
      loadProgress,
      togglePractica,
      toggleProyecto,
      setLeccion,
      markMateriaCompletada,
      touchMateria,
    } from '../../lib/progress-client';

    const materiaIdPage = document.querySelector('[data-completa]')?.getAttribute('data-materia');
    if (materiaIdPage) touchMateria(materiaIdPage);

    function syncUI() {
      const materiaId = document.querySelector('[data-completa]')?.getAttribute('data-materia');
      if (!materiaId) return;
      const m = loadProgress()?.materias?.[materiaId];
      document.querySelectorAll('[data-practica]').forEach((el) => {
        const id = el.getAttribute('data-practica')!;
        (el as HTMLInputElement).checked = Boolean(m?.practicas?.[id]);
      });
      document.querySelectorAll<HTMLInputElement>('input[data-leccion]').forEach((el) => {
        const id = el.getAttribute('data-leccion')!;
        el.checked = Boolean(m?.lecciones?.[id]);
      });
      const proj = document.querySelector('[data-proyecto]') as HTMLInputElement | null;
      if (proj) proj.checked = Boolean(m?.proyecto);
      const comp = document.querySelector('[data-completa]') as HTMLInputElement | null;
      if (comp) comp.checked = m?.status === 'completada';
    }

    document.querySelectorAll('[data-practica]').forEach((el) => {
      el.addEventListener('change', () => {
        const materiaId = el.getAttribute('data-materia')!;
        const practicaId = el.getAttribute('data-practica')!;
        togglePractica(materiaId, practicaId);
        syncUI();
      });
    });

    document.querySelectorAll<HTMLInputElement>('input[data-leccion]').forEach((el) => {
      el.addEventListener('change', () => {
        const materiaId = el.getAttribute('data-materia')!;
        const leccionId = el.getAttribute('data-leccion')!;
        setLeccion(materiaId, leccionId, el.checked);
        syncUI();
      });
    });

    document.querySelector('[data-proyecto]')?.addEventListener('change', (e) => {
      const el = e.currentTarget as HTMLInputElement;
      toggleProyecto(el.getAttribute('data-materia')!);
      syncUI();
    });

    document.querySelector('[data-completa]')?.addEventListener('change', (e) => {
      const el = e.currentTarget as HTMLInputElement;
      markMateriaCompletada(el.getAttribute('data-materia')!, el.checked);
      syncUI();
    });

    syncUI();
    window.addEventListener('academia-progress', syncUI);
  </script>
</Layout>
