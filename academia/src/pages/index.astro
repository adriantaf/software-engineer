---
import Layout from '../layouts/Layout.astro';
import {
  getCatalog,
  getMateriasByEtapa,
  getProgressSeed,
  totalStats,
} from '../lib/curriculum';
import { pathTo } from '../lib/paths';

const catalog = getCatalog();
const stats = totalStats();
const seed = getProgressSeed();

const etapaMeta: Record<
  string,
  { label: string; hint: string }
> = {
  basica: { label: 'Cimientos', hint: 'Lenguaje, git y bases' },
  disciplinaria: { label: 'Oficio', hint: 'Producto y sistemas' },
  terminal: { label: 'Salida', hint: 'Producción y egreso' },
};
---

<Layout title="Inicio" bareMain>
  <script type="application/json" id="progress-seed" set:html={JSON.stringify(seed)} />

  <section class="hero-atelier" aria-label="Portada">
    <div class="hero-atelier__scene" aria-hidden="true">
      <img
        class="hero-atelier__scene-img"
        src={pathTo('hero-atelier.svg')}
        width="720"
        height="480"
        alt=""
        decoding="async"
      />
    </div>
    <div class="hero-atelier__inner max-w-6xl mx-auto px-3 sm:px-4 w-full">
      <p class="hero-atelier__brand">Atelier</p>
      <h1 class="hero-atelier__headline">{catalog.programa}</h1>
      <p class="hero-atelier__lede">
        Competencia de software con proyectos útiles, evidencia en git y ritmo de{' '}
        {catalog.ritmoHorasSemana} h/semana — sin atajos de tutorial.
      </p>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-primary" data-home-cta href={pathTo('materia/M01/leccion/L01')}>
          Empezar M01
        </a>
        <a class="btn btn-outline" href={pathTo('docs/como-estudiar')}>Cómo estudiar</a>
      </div>
    </div>
  </section>

  <div class="container mx-auto px-3 sm:px-4 max-w-6xl w-full min-w-0 py-8 sm:py-10 pb-12">
    <section class="section-atelier" aria-labelledby="etapas-title">
      <h2 id="etapas-title" class="section-atelier__title">Tres etapas</h2>
      <p class="section-atelier__lede">
        {stats.materias} materias · ~{stats.horas} h de plan · ~{stats.semanas} semanas a ritmo meta.
      </p>

      <div id="etapa-list" class="stagger-in etapa-card-list">
        {
          catalog.etapas.map((etapa) => {
            const mats = getMateriasByEtapa(etapa.id);
            const horas = mats.reduce((a, m) => a + m.horas, 0);
            const meta = etapaMeta[etapa.id] ?? {
              label: `Etapa ${etapa.orden}`,
              hint: etapa.objetivo,
            };
            return (
              <a
                href={pathTo(`etapa/${etapa.id}`)}
                class="etapa-card"
                data-etapa={etapa.id}
                data-etapa-card={etapa.id}
              >
                <span class="etapa-card__rail" aria-hidden="true" />
                <div class="etapa-card__top">
                  <p class="etapa-card__meta">
                    <span class="etapa-card__meta-label">{meta.label}</span>
                    <span class="etapa-card__meta-sep" aria-hidden="true">
                      ·
                    </span>
                    <span>Etapa {etapa.orden}</span>
                  </p>
                  <span class="etapa-card__status" data-etapa-label={etapa.id}>
                    0%
                  </span>
                </div>
                <h3 class="etapa-card__title">{etapa.titulo}</h3>
                <p class="etapa-card__desc">{etapa.objetivo}</p>
                <p class="etapa-card__stats">
                  {mats.length} materias · ~{etapa.duracionMeses} meses · {horas} h
                  <span class="etapa-card__hint"> · {meta.hint}</span>
                </p>
                <progress
                  class="progress progress-primary progress-atelier etapa-card__progress"
                  data-etapa={etapa.id}
                  value="0"
                  max="100"
                  aria-hidden="true"
                />
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="section-atelier" aria-labelledby="recursos-title">
      <h2 id="recursos-title" class="section-atelier__title">Recursos</h2>
      <p class="section-atelier__lede">
        Guías del plan. Física, química o cálculo avanzado, si los necesitas, van aparte.
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm list-none p-0 m-0">
        <li><a class="link link-primary" href={pathTo('docs/glosario')}>Glosario</a></li>
        <li><a class="link link-primary" href={pathTo('docs/bibliografia')}>Bibliografía</a></li>
        <li><a class="link link-primary" href={pathTo('docs/producto-saas')}>Producto SaaS</a></li>
        <li><a class="link link-primary" href={pathTo('docs/seguridad')}>Hilo seguridad</a></li>
        <li><a class="link link-primary" href={pathTo('docs/labs')}>Labs</a></li>
        <li><a class="link link-primary" href={pathTo('revision')}>Revisión de emergencia</a></li>
        <li><a class="link link-primary" href={pathTo('egreso')}>Egreso</a></li>
        <li><a class="link link-primary" href={pathTo('docs/index')}>Mapa</a></li>
        <li><a class="link link-primary" href={pathTo('progreso')}>Progreso</a></li>
      </ul>
    </section>
  </div>

  <script type="application/json" id="catalog-lite" set:html={JSON.stringify({
    etapas: catalog.etapas.map((e) => ({
      id: e.id,
      materiaIds: getMateriasByEtapa(e.id).map((m) => m.id),
    })),
  })} />

  <script>
    import { loadProgress, resolveContinuePath } from '../lib/progress-client';
    import { pathTo } from '../lib/paths';

    function refresh() {
      const raw = document.getElementById('catalog-lite')?.textContent;
      if (!raw) return;
      const catalog = JSON.parse(raw) as { etapas: { id: string; materiaIds: string[] }[] };
      const progress = loadProgress();
      for (const etapa of catalog.etapas) {
        const done = etapa.materiaIds.filter(
          (id) => progress?.materias?.[id]?.status === 'completada',
        ).length;
        const pct = etapa.materiaIds.length
          ? Math.round((done / etapa.materiaIds.length) * 100)
          : 0;
        const bar = document.querySelector(`progress[data-etapa="${etapa.id}"]`);
        const label = document.querySelector(`[data-etapa-label="${etapa.id}"]`);
        if (bar) bar.setAttribute('value', String(pct));
        if (label) {
          const status = pct === 0 ? 'Sin empezar' : pct === 100 ? 'Completa' : `${pct}%`;
          label.textContent = status;
          label.dataset.pct = String(pct);
          label.dataset.state =
            pct === 0 ? 'idle' : pct === 100 ? 'done' : 'active';
        }
      }

      const ids = catalog.etapas.flatMap((e) => e.materiaIds);
      const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
      let leccionesByMateria: Record<string, string[]> = {};
      try {
        leccionesByMateria = lecRaw ? (JSON.parse(lecRaw) as Record<string, string[]>) : {};
      } catch {
        leccionesByMateria = {};
      }
      const rel = resolveContinuePath(ids, leccionesByMateria);
      const cta = document.querySelector<HTMLAnchorElement>('[data-home-cta]');
      if (cta) {
        cta.href = pathTo(rel);
        const mid = rel.split('/')[1] ?? 'M01';
        const hasProgress = Boolean(
          progress?.materias && Object.keys(progress.materias).length > 0,
        );
        cta.textContent = hasProgress ? `Continuar ${mid}` : 'Empezar M01';
      }
    }

    refresh();
    window.addEventListener('academia-progress', refresh);
  </script>
</Layout>
