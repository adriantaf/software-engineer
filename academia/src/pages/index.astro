---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CourseCard from '../components/CourseCard.astro';
import CourseGrid from '../components/CourseGrid.astro';
import {
  getCatalog,
  getLeccionesCatalog,
  getMateriasByEtapa,
  getProgressSeed,
  totalStats,
} from '../lib/curriculum';
import { pathTo } from '../lib/paths';

const catalog = getCatalog();
const stats = totalStats();
const seed = getProgressSeed();
const leccionesByMateria = getLeccionesCatalog();
const etapaById = Object.fromEntries(catalog.etapas.map((e) => [e.id, e]));

const featured = catalog.materias.filter((m) => ['M01', 'M02', 'M03', 'M04'].includes(m.id));
const continuarHref = pathTo('materia/M01/leccion/L01');

const guideLinks = [
  { href: pathTo('docs/como-estudiar'), label: 'Cómo estudiar' },
  { href: pathTo('docs/glosario'), label: 'Glosario' },
  { href: pathTo('docs/bibliografia'), label: 'Bibliografía' },
  { href: pathTo('docs/producto-saas'), label: 'Producto SaaS' },
  { href: pathTo('docs/seguridad'), label: 'Hilo seguridad' },
  { href: pathTo('egreso'), label: 'Egreso' },
  { href: pathTo('docs/index'), label: 'Mapa curricular' },
  { href: pathTo('progreso'), label: 'Progreso' },
];
---

<Layout title="Inicio" bareMain>
  <script type="application/json" id="progress-seed" set:html={JSON.stringify(seed)} />

  <HomeHero
    programa={catalog.programa}
    ritmoHoras={catalog.ritmoHorasSemana}
    materias={stats.materias}
    horas={stats.horas}
    semanas={stats.semanas}
    continuarHref={continuarHref}
  />

  <div class="plan-shell py-10 sm:py-12 flex flex-col gap-12 sm:gap-16">
    <section id="etapa-cards">
      <SectionHeading
        title="Elige tu etapa"
        subtitle="Tres bloques del plan, del fundamento al egreso."
      />
      <div class="grid gap-4 md:grid-cols-3 catalog-reveal">
        {
          catalog.etapas.map((etapa) => {
            const mats = getMateriasByEtapa(etapa.id);
            const horas = mats.reduce((a, m) => a + m.horas, 0);
            return (
              <CategoryCard
                id={etapa.id}
                titulo={etapa.titulo}
                objetivo={etapa.objetivo}
                orden={etapa.orden}
                materiaCount={mats.length}
                horas={horas}
                duracionMeses={etapa.duracionMeses}
              />
            );
          })
        }
      </div>
    </section>

    <section>
      <SectionHeading
        title="Empieza aquí"
        subtitle="Las primeras materias de Fundamentos para tomar ritmo."
        href={pathTo('etapa/basica')}
        linkLabel="Ver Fundamentos"
      />
      <CourseGrid>
        {
          featured.map((m) => {
            const etapa = etapaById[m.etapa]!;
            return (
              <CourseCard
                id={m.id}
                titulo={m.titulo}
                etapaId={m.etapa}
                etapaTitulo={etapa.titulo}
                horas={m.horas}
                semanas={m.semanas}
                leccionCount={leccionesByMateria[m.id]?.length ?? 0}
              />
            );
          })
        }
      </CourseGrid>
    </section>

    {
      catalog.etapas.map((etapa) => {
        const mats = getMateriasByEtapa(etapa.id);
        return (
          <section>
            <SectionHeading
              title={etapa.titulo}
              subtitle={etapa.objetivo}
              href={pathTo(`etapa/${etapa.id}`)}
              linkLabel="Ver etapa"
            />
            <CourseGrid>
              {mats.map((m) => (
                <CourseCard
                  id={m.id}
                  titulo={m.titulo}
                  etapaId={m.etapa}
                  etapaTitulo={etapa.titulo}
                  horas={m.horas}
                  semanas={m.semanas}
                  leccionCount={leccionesByMateria[m.id]?.length ?? 0}
                />
              ))}
            </CourseGrid>
          </section>
        );
      })
    }

    <section class="pb-4">
      <SectionHeading title="Guías académicas" subtitle="Referencias compactas del plan." />
      <ul class="flex flex-wrap gap-x-5 gap-y-2 m-0 p-0 list-none text-sm">
        {
          guideLinks.map((g) => (
            <li>
              <a class="font-medium text-plan-primary hover:underline" href={g.href}>
                {g.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <script type="application/json" id="catalog-lite" set:html={JSON.stringify({
    etapas: catalog.etapas.map((e) => ({
      id: e.id,
      materiaIds: getMateriasByEtapa(e.id).map((m) => m.id),
    })),
  })} />

  <script>
    import { loadProgress, resolveContinuePath } from '../lib/progress-client';
    import { pathTo } from '../lib/paths';

    function refresh() {
      const raw = document.getElementById('catalog-lite')?.textContent;
      if (!raw) return;
      const catalog = JSON.parse(raw) as { etapas: { id: string; materiaIds: string[] }[] };
      const progress = loadProgress();
      const statusMap: Record<string, string> = {
        completada: 'status-chip status-chip--ok course-card__chip',
        en_curso: 'status-chip status-chip--warn course-card__chip',
        disponible: 'status-chip status-chip--info course-card__chip',
        bloqueada: 'status-chip status-chip--muted course-card__chip',
      };
      const labels: Record<string, string> = {
        completada: 'Hecha',
        en_curso: 'En curso',
        disponible: 'Lista',
        bloqueada: 'Bloqueada',
      };

      for (const etapa of catalog.etapas) {
        const done = etapa.materiaIds.filter(
          (id) => progress?.materias?.[id]?.status === 'completada',
        ).length;
        const pct = etapa.materiaIds.length
          ? Math.round((done / etapa.materiaIds.length) * 100)
          : 0;
        const bar = document.querySelector(`progress[data-etapa="${etapa.id}"]`);
        const label = document.querySelector(`[data-etapa-label="${etapa.id}"]`);
        if (bar) bar.setAttribute('value', String(pct));
        if (label) {
          label.textContent =
            pct === 0 ? '0%' : pct === 100 ? 'Lista' : `${pct}%`;
          label.dataset.state =
            pct === 0 ? 'idle' : pct === 100 ? 'done' : 'active';
        }

        for (const mid of etapa.materiaIds) {
          const chip = document.querySelector(`.course-card__chip[data-status="${mid}"]`);
          if (!chip) continue;
          const st = progress?.materias?.[mid]?.status || 'disponible';
          chip.className = statusMap[st] ?? statusMap.disponible;
          chip.textContent = labels[st] ?? '—';
        }
      }

      const ids = catalog.etapas.flatMap((e) => e.materiaIds);
      const lecRaw = document.getElementById('lecciones-catalog')?.textContent;
      let leccionesByMateria: Record<string, string[]> = {};
      try {
        leccionesByMateria = lecRaw ? (JSON.parse(lecRaw) as Record<string, string[]>) : {};
      } catch {
        leccionesByMateria = {};
      }
      const rel = resolveContinuePath(ids, leccionesByMateria);
      document.querySelectorAll<HTMLAnchorElement>('[data-continuar]').forEach((el) => {
        el.href = pathTo(rel);
        if (!el.hasAttribute('data-continuar-keep-label')) {
          const mid = rel.split('/')[1] ?? 'M01';
          const hasProgress = Boolean(
            progress?.materias && Object.keys(progress.materias).length > 0,
          );
          el.textContent = hasProgress ? `Continuar ${mid}` : 'Continuar aprendiendo';
        }
      });
    }

    refresh();
    window.addEventListener('academia-progress', refresh);
  </script>
</Layout>
